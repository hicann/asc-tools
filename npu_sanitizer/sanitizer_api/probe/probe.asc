#include "kernel_operator.h"

#include "probe_record.h"

#define BUILD_DYNAMIC_PROBE 1

__gm__ uint8_t* __gm__ g_sanitizerOutput = nullptr;
__gm__ uint32_t g_sanitizerAivOffset = 0;

template <typename Record>
__aicore__ inline void WriteProbeRecord(uint32_t bid, const Record& record)
{
    (void)bid;
    if (g_sanitizerOutput == nullptr) {
        return;
    }

    AscendC::printf("[PROBE-ASC] block=%u pc=0x%lx\n",
        static_cast<uint32_t>(AscendC::GetBlockIdx()),
        static_cast<uint64_t>(record.common.pc));
    const uint32_t blockId = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t phyCoreId = static_cast<uint32_t>(get_coreid());
    uint32_t outputBlock = blockId;
    if ASCEND_IS_AIV {
        outputBlock += g_sanitizerAivOffset;
    }
    __gm__ uint8_t* blockBase = g_sanitizerOutput +
        static_cast<uint64_t>(outputBlock) * sanitizer::kProbeBlockBytes;
    __gm__ sanitizer::ProbeBlockHeader* header =
        reinterpret_cast<__gm__ sanitizer::ProbeBlockHeader*>(blockBase);

    dcci(header, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
    const uint64_t offset = header->curAddr;
    constexpr uint64_t recordBytes = sizeof(uint64_t) + sizeof(Record);
    if (offset < sanitizer::kProbeRecordStartBytes ||
        offset > sanitizer::kProbeBlockBytes - recordBytes) {
        return;
    }

    __gm__ uint8_t* recordStart = blockBase + offset;
    *reinterpret_cast<__gm__ uint64_t*>(recordStart) = sizeof(Record);
    __gm__ uint8_t* payload = recordStart + sizeof(uint64_t);
    const uint8_t* source = reinterpret_cast<const uint8_t*>(&record);
    for (uint64_t index = 0; index < sizeof(Record); ++index) {
        payload[index] = source[index];
    }
    dcci(recordStart, cache_line_t::ENTIRE_DATA_CACHE, dcci_dst_t::CACHELINE_OUT);

    header->curAddr = offset + recordBytes;
    header->instrNum += 1;
    header->blockId = blockId;
    header->phyCoreId = phyCoreId;
    dcci(header, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}

__attribute__((noinline)) __attribute__((weak)) __aicore__
void __sanitizer_report_copy_gm_to_ubuf(__gm__ uint8_t* memInfo, int64_t pc,
    uint32_t bid, __ubuf__ void* dst, __gm__ void* src, uint64_t len)
{
    (void)memInfo;
    WriteProbeRecord(bid, sanitizer::CopyRecord{
        {static_cast<uint32_t>(sanitizer::ProbeInstrType::CopyGmToUbuf), pc},
        reinterpret_cast<uint64_t>(dst), reinterpret_cast<uint64_t>(src), len});
}

#define DEFINE_ALIGN_PROBE(functionName, instructionType) \
    __attribute__((noinline)) __attribute__((weak)) __aicore__ \
    void functionName(__gm__ uint8_t* memInfo, int64_t pc, uint32_t bid, \
        __ubuf__ void* dst, __gm__ void* src, uint64_t config0, uint64_t config1) \
    { \
        (void)memInfo; \
        WriteProbeRecord(bid, sanitizer::CopyAlignRecord{ \
            {static_cast<uint32_t>(instructionType), pc}, \
            reinterpret_cast<uint64_t>(dst), reinterpret_cast<uint64_t>(src), \
            config0, config1}); \
    }

DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_b8,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignB8)
DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_b16,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignB16)
DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_b32,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignB32)
DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_v2_b8,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignV2B8)
DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_v2_b16,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignV2B16)
DEFINE_ALIGN_PROBE(__sanitizer_report_copy_gm_to_ubuf_align_v2_b32,
    sanitizer::ProbeInstrType::CopyGmToUbufAlignV2B32)

#undef DEFINE_ALIGN_PROBE

__attribute__((noinline)) __attribute__((weak)) __aicore__
void __sanitizer_report_copy_ubuf_to_gm_align_v2(__gm__ uint8_t* memInfo, int64_t pc,
    uint32_t bid, __gm__ void* dst, __ubuf__ void* src, uint64_t config0, uint64_t config1)
{
    (void)memInfo;
    WriteProbeRecord(bid, sanitizer::CopyAlignRecord{
        {static_cast<uint32_t>(sanitizer::ProbeInstrType::CopyUbufToGmAlignV2), pc},
        reinterpret_cast<uint64_t>(dst), reinterpret_cast<uint64_t>(src), config0, config1});
}

__aicore__ inline void ReportFlag(sanitizer::ProbeInstrType type, int64_t pc,
    uint32_t bid, pipe_t srcPipe, pipe_t dstPipe, uint64_t eventId)
{
    WriteProbeRecord(bid, sanitizer::FlagRecord{
        {static_cast<uint32_t>(type), pc},
        static_cast<uint32_t>(srcPipe), static_cast<uint32_t>(dstPipe), eventId});
}

__aicore__ inline void ReportBuffer(sanitizer::ProbeInstrType type, int64_t pc,
    uint32_t bid, uint32_t pipe, uint64_t bufId, bool mode)
{
    WriteProbeRecord(bid, sanitizer::BufferRecord{
        {static_cast<uint32_t>(type), pc}, bufId, pipe, static_cast<uint8_t>(mode),
        {0, 0, 0}});
}

__attribute__((noinline)) __attribute__((weak)) __aicore__
void __sanitizer_report_set_flag(__gm__ uint8_t* memInfo, int64_t pc, uint32_t bid,
    pipe_t srcPipe, pipe_t dstPipe, uint64_t eventId)
{
    (void)memInfo;
    ReportFlag(sanitizer::ProbeInstrType::SetFlag, pc, bid, srcPipe, dstPipe, eventId);
}

