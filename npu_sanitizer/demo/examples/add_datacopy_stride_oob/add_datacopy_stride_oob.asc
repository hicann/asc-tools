#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {

constexpr uint32_t kBurstCount = 3;
constexpr uint32_t kBurstBytes = 32;
constexpr int64_t kSourceGapBytes = 16;
constexpr uint32_t kCopiedElements = kBurstCount * kBurstBytes / sizeof(float);
constexpr uint32_t kAllocationElements = 28;
constexpr size_t kAllocationBytes = kAllocationElements * sizeof(float);

bool CheckAclResult(aclError result, const char* apiName)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: result=%d\n", apiName, result);
    return false;
}

} // namespace

__vector__ __global__ void DataCopyStrideOobCustom(__gm__ float* input)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> inputGm;
    inputGm.SetGlobalBuffer(input, kAllocationElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> inputLocal = ubAllocator.Alloc<float, kCopiedElements>();

    // GM bursts are [0, 32), [48, 80), and [96, 128). The 112-byte allocation
    // keeps the first two bursts valid while the third burst exceeds it by 16 bytes.
    const AscendC::DataCopyExtParams copyParams{
        kBurstCount, kBurstBytes, kSourceGapBytes, 0, 0};
    const AscendC::DataCopyPadExtParams<float> paddingParams{false, 0, 0, 0};
    AscendC::DataCopyPad(inputLocal, inputGm, copyParams, paddingParams);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main()
{
    std::vector<float> input(kAllocationElements, 1.0F);
    float* inputDevice = nullptr;
    aclrtStream stream = nullptr;
    constexpr int32_t kDeviceId = 0;

    if (!CheckAclResult(aclInit(nullptr), "aclInit") ||
        !CheckAclResult(aclrtSetDevice(kDeviceId), "aclrtSetDevice") ||
        !CheckAclResult(aclrtCreateStream(&stream), "aclrtCreateStream") ||
        !CheckAclResult(
            aclrtMalloc(reinterpret_cast<void**>(&inputDevice), kAllocationBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc") ||
        !CheckAclResult(aclrtMemcpy(inputDevice, kAllocationBytes, input.data(), kAllocationBytes,
            ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy")) {
        return 1;
    }

    DataCopyStrideOobCustom<<<1, 0, stream>>>(inputDevice);
    if (!CheckAclResult(aclrtSynchronizeStreamWithTimeout(stream, 10000), "aclrtSynchronizeStreamWithTimeout")) {
        return 1;
    }

    std::printf("non-contiguous DataCopy kernel completed\n");
    const bool cleanupSucceeded = CheckAclResult(aclrtFree(inputDevice), "aclrtFree") &&
        CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") &&
        CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") &&
        CheckAclResult(aclFinalize(), "aclFinalize");
    return cleanupSucceeded ? 0 : 1;
}
