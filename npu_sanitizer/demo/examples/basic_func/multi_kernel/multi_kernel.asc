#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {

constexpr uint32_t kBurstCount = 3;
constexpr uint32_t kBurstBytes = 32;
constexpr int64_t kSourceGapBytes = 16;
constexpr uint32_t kCopiedElements = kBurstCount * kBurstBytes / sizeof(float);
constexpr uint32_t kAllocationElements = 28;
constexpr size_t kAllocationBytes = kAllocationElements * sizeof(float);
constexpr int32_t kDeviceId = 0;
constexpr int32_t kKernelTimeoutMs = 10000;

} // namespace

#define ACL_CHECK(apiCall)                                                                                         \
    do {                                                                                                           \
        const aclError result = (apiCall);                                                                         \
        if (result != ACL_SUCCESS) {                                                                               \
            std::fprintf(stderr, "%s failed: result=%d\n", #apiCall, result);                                      \
            return 1;                                                                                              \
        }                                                                                                          \
    } while (false)

__vector__ __global__ void DataCopyStrideSingleInput(__gm__ float* input)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> inputGm;
    inputGm.SetGlobalBuffer(input, kAllocationElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> inputLocal = ubAllocator.Alloc<float, kCopiedElements>();

    // GM bursts are [0, 32), [48, 80), and [96, 128). The final burst exceeds the 112-byte allocation by 16 bytes.
    const AscendC::DataCopyExtParams copyParams{kBurstCount, kBurstBytes, kSourceGapBytes, 0, 0};
    const AscendC::DataCopyPadExtParams<float> paddingParams{false, 0, 0, 0};
    AscendC::DataCopyPad(inputLocal, inputGm, copyParams, paddingParams);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 测试2个gm地址 + int场景下，probe时插入args是否会有问题
__mix__(1, 2) __global__ void DataCopyStrideDualInput(__gm__ float* firstInput, __gm__ float* secondInput, int a)
{
    if (a != 5) {
        return;
    }
    AscendC::InitSocState();

    if ASCEND_IS_AIC {
        AscendC::GlobalTensor<float> inputGm;
        inputGm.SetGlobalBuffer(firstInput, kAllocationElements);

        AscendC::LocalMemAllocator<AscendC::Hardware::L1> ubAllocator;
        AscendC::LocalTensor<float> inputLocal = ubAllocator.Alloc<float, kCopiedElements>();

        // GM bursts are [0, 32), [48, 80), and [96, 128). The final burst exceeds the 112-byte allocation by 16 bytes.
        const AscendC::DataCopyExtParams copyParams{kBurstCount, kBurstBytes, kSourceGapBytes, 0, 0};
        const AscendC::DataCopyPadExtParams<float> paddingParams{false, 0, 0, 0};
        AscendC::DataCopyPad(inputLocal, inputGm, copyParams, paddingParams);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main()
{
    const std::vector<float> firstInputHost(kAllocationElements, 1.0F);
    const std::vector<float> secondInputHost(kAllocationElements, 2.0F);
    float* firstInputDevice = nullptr;
    float* secondInputDevice = nullptr;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void**>(&firstInputDevice), kAllocationBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(
        reinterpret_cast<void**>(&secondInputDevice), kAllocationBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(firstInputDevice, kAllocationBytes, firstInputHost.data(), kAllocationBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(secondInputDevice, kAllocationBytes, secondInputHost.data(), kAllocationBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));

    // 两个kernel一起执行，需要区分出launch id或者kernel名字
    DataCopyStrideSingleInput<<<1, 0, stream>>>(firstInputDevice);
    DataCopyStrideDualInput<<<1, 0, stream>>>(firstInputDevice, secondInputDevice, 5);
    ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, kKernelTimeoutMs));


    ACL_CHECK(aclrtFree(secondInputDevice));
    ACL_CHECK(aclrtFree(firstInputDevice));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(kDeviceId));
    ACL_CHECK(aclFinalize());
    return 0;
}
