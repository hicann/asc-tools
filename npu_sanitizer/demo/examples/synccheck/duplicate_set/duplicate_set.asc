/*! \file duplicate_set.asc */

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __global__ __cube__ void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    // Scenario: the same AIC flag is set twice without an intervening WAIT_FLAG.
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
}

int RunSample(uint32_t blockCount = 8)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
