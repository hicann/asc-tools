/*! \file mutex_duplicate_lock.asc */

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 10000;
} // namespace

extern "C" __vector__ __global__ __aicore__ void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    const uint8_t mutexId = AscendC::AllocMutexID();

    // Scenario: the same mutex is acquired twice without an intervening RLS_BUF.
    AscendC::Mutex::Lock<PIPE_MTE2>(mutexId);
    AscendC::Mutex::Lock<PIPE_MTE2>(mutexId);

    AscendC::ReleaseMutexID(mutexId);
}

int RunSample(uint32_t blockCount = 1)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    // The blocked kernel requires a forced stream teardown after the bounded synchronization.
    aclrtDestroyStreamForce(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
