/*! \file mutex_pair.asc */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __vector__ __global__ __aicore__ void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    constexpr uint8_t mutexId = 0;

    // Scenario: matching GET_BUF/RLS_BUF pairs execute on the MTE2 and vector pipelines.
    asc_lock(PIPE_MTE2, mutexId);
    asc_unlock(PIPE_MTE2, mutexId);
    asc_lock(PIPE_V, mutexId);
    asc_unlock(PIPE_V, mutexId);
}

int RunSample(uint32_t blockCount = 1)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
