#include <algorithm>
#include <cstdint>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t kElementCount = 32;
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __vector__ __global__ __aicore__ void synccheck_demo_kernel(
    uint64_t reserved, __gm__ float* input, __gm__ float* output)
{
    AscendC::InitSocState();
    (void)reserved;
    AscendC::GlobalTensor<float> inputGm, outputGm;
    inputGm.SetGlobalBuffer(input, kElementCount);
    outputGm.SetGlobalBuffer(output, kElementCount);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<float> local = allocator.Alloc<float, kElementCount>();
    const uint8_t mutexId = AscendC::AllocMutexID();

    // Scenario: block 0 releases its GET_BUF, while block 1 leaves the same mutex ID acquired.
    AscendC::Mutex::Lock<PIPE_MTE2>(mutexId);
    AscendC::DataCopy(local, inputGm, kElementCount);
    if (AscendC::GetBlockIdx() == 0) {
        AscendC::Mutex::Unlock<PIPE_MTE2>(mutexId);
    }

    AscendC::DataCopy(outputGm, local, kElementCount);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::ReleaseMutexID(mutexId);
}

int RunSample(uint32_t blockCount = 1)
{
    const size_t bytes = kElementCount * sizeof(float);
    std::vector<float> input(kElementCount, 1.0F), output(kElementCount, 0.0F);
    float* inputDevice = nullptr;
    float* outputDevice = nullptr;
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    aclrtMalloc(reinterpret_cast<void**>(&inputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(inputDevice, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    synccheck_demo_kernel<<<blockCount, 0, stream>>>(0, inputDevice, outputDevice);
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtMemcpy(output.data(), bytes, outputDevice, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtFree(inputDevice);
    aclrtFree(outputDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return std::equal(input.begin(), input.end(), output.begin()) ? 0 : 1;
}

int main() { return RunSample(2); }
