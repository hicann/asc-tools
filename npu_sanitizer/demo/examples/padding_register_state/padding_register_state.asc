/*!
 * \file padding_register_state.asc
 * \brief Record two SET_PADDING values for one register-state key.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

namespace {

constexpr int32_t STREAM_TIMEOUT_MS = 5000;
constexpr uint64_t FIRST_PADDING_INPUT = UINT64_C(0x12);
constexpr uint64_t SECOND_PADDING_INPUT = UINT64_C(0x34);

} // namespace

extern "C" __global__ __cube__ void PaddingRegisterStateKernel(
    uint64_t reserved, uint64_t firstValue, uint64_t secondValue)
{
    (void)reserved;
    asc_set_l13d_padding(firstValue);
    asc_set_l13d_padding(secondValue);
}

int RunSample()
{
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS || aclrtCreateStream(&stream) != ACL_SUCCESS) {
        aclFinalize();
        return 1;
    }

    PaddingRegisterStateKernel<<<1, 0, stream>>>(0, FIRST_PADDING_INPUT, SECOND_PADDING_INPUT);
    const bool runSucceeded = aclrtSynchronizeStreamWithTimeout(stream, STREAM_TIMEOUT_MS) == ACL_SUCCESS;

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::printf("padding register state demo %s!\n", runSucceeded ? "pass" : "failed");
    return runSucceeded ? 0 : 1;
}

int main() { return RunSample(); }
