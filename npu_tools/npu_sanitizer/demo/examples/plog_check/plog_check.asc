#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <unistd.h>

namespace {

constexpr int32_t kDeviceId = 0;
constexpr int32_t kStreamTimeoutMs = 5000;

bool CheckAclResult(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: result=%d\n", operation, status);
    return false;
}

} // namespace

extern "C" __vector__ __global__ __aicore__ void PlogCheckKernel() { AscendC::InitSocState(); }

int main(int argc, char** argv)
{
    if (argc != 2) {
        std::fprintf(stderr, "usage: plog_check <pid-file>\n");
        return 1;
    }
    std::FILE* pidFile = std::fopen(argv[1], "w");
    if (pidFile == nullptr) {
        return 1;
    }
    const bool pidWritten = std::fprintf(pidFile, "%ld\n", static_cast<long>(getpid())) > 0;
    const bool pidClosed = std::fclose(pidFile) == 0;
    if (!pidWritten || !pidClosed) {
        return 1;
    }
    if (!CheckAclResult(aclInit(nullptr), "aclInit")) {
        return 1;
    }

    aclrtStream stream = nullptr;
    if (!CheckAclResult(aclrtSetDevice(kDeviceId), "aclrtSetDevice") ||
        !CheckAclResult(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        (void)aclFinalize();
        return 1;
    }

    PlogCheckKernel<<<1, 0, stream>>>();
    const bool synchronized = CheckAclResult(
        aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs), "aclrtSynchronizeStreamWithTimeout");
    const bool streamDestroyed = CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream");
    const bool deviceReset = CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice");
    const bool finalized = CheckAclResult(aclFinalize(), "aclFinalize");
    return synchronized && streamDestroyed && deviceReset && finalized ? 0 : 1;
}
