/*!
 * \file cube_loop_memory_case.asc
 * \brief Parameterized dav-3510 GM-to-L1 outer-loop memory-access case.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef CUBE_LOOP_INSTRUCTION_ID
#error "CUBE_LOOP_INSTRUCTION_ID is required"
#endif
#ifndef CUBE_LOOP_GM_ALLOCATION_BYTES
#error "CUBE_LOOP_GM_ALLOCATION_BYTES is required"
#endif

static_assert(
    CUBE_LOOP_INSTRUCTION_ID >= 73 && CUBE_LOOP_INSTRUCTION_ID <= 76,
    "CUBE_LOOP_INSTRUCTION_ID must be 73, 74, 75, or 76");
static_assert(CUBE_LOOP_GM_ALLOCATION_BYTES > 0, "CUBE_LOOP_GM_ALLOCATION_BYTES must be nonzero");

namespace {

constexpr uint32_t kLoop1Size = 2;
constexpr uint32_t kLoop2Size = 3;
constexpr uint64_t kGmLoop1StrideBytes = 64;
constexpr uint64_t kGmLoop2StrideBytes = 192;
constexpr uint64_t kL1Loop1StrideBytes = 32;
constexpr uint64_t kL1Loop2StrideBytes = 64;
constexpr uint32_t kAccessBytes = 32;
constexpr uint32_t kGmAccessEndBytes =
    (kLoop2Size - 1) * kGmLoop2StrideBytes + (kLoop1Size - 1) * kGmLoop1StrideBytes + kAccessBytes;
constexpr uint32_t kL1WorkspaceBytes = 256;

} // namespace

extern "C" __cube__ __global__ void CubeLoopMemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* unused, __gm__ uint8_t* guard)
{
    asc_init();
    __cbuf__ uint8_t local[kL1WorkspaceBytes];

    asc_set_gm2l1_loop_size(kLoop1Size, kLoop2Size);
    asc_set_gm2l1_loop1_stride(kGmLoop1StrideBytes, kL1Loop1StrideBytes);
    asc_set_gm2l1_loop2_stride(kGmLoop2StrideBytes, kL1Loop2StrideBytes);
    // GM reads are [0, 32), [64, 96), [192, 224), [256, 288), [384, 416), and [448, 480).
#if CUBE_LOOP_INSTRUCTION_ID == 73
    asc_copy_gm2l1(
        reinterpret_cast<__cbuf__ void*>(local), reinterpret_cast<__gm__ void*>(source), 1, 1, 0, 0, 0);
#elif CUBE_LOOP_INSTRUCTION_ID == 74
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ uint8_t*>(local), reinterpret_cast<__gm__ uint8_t*>(source), 1, kAccessBytes,
        0, 0, false, 0, 0, 0);
#elif CUBE_LOOP_INSTRUCTION_ID == 75
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ half*>(local), reinterpret_cast<__gm__ half*>(source), 1, kAccessBytes,
        0, 0, false, 0, 0, 0);
#else
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ float*>(local), reinterpret_cast<__gm__ float*>(source), 1, kAccessBytes,
        0, 0, false, 0, 0, 0);
#endif
    asc_set_gm2l1_loop_size(1, 1);

    asc_sync_pipe(PIPE_ALL);
    (void)unused;
    (void)guard;
}

int main()
{
    std::printf(
        "CUBE_LOOP_INSTRUCTION_ID=%d CUBE_LOOP_EXPECTED_GM_FOOTPRINT_BYTES=%u "
        "CUBE_LOOP_ALLOCATED_GM_BYTES=%zu\n",
        CUBE_LOOP_INSTRUCTION_ID, kGmAccessEndBytes, static_cast<size_t>(CUBE_LOOP_GM_ALLOCATION_BYTES));
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(CUBE_LOOP_GM_ALLOCATION_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(
        aclrtMalloc(reinterpret_cast<void**>(&first), CUBE_LOOP_GM_ALLOCATION_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        first, CUBE_LOOP_GM_ALLOCATION_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    CubeLoopMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
