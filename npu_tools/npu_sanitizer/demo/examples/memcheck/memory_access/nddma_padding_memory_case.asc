/*!
 * \file nddma_padding_memory_case.asc
 * \brief Supported NDDMA constant/nearest padding cases lowered through the public DataCopy API.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef NDDMA_PADDING_BITS
#error "NDDMA_PADDING_BITS is required"
#endif
#ifndef NDDMA_PADDING_SOURCE_BYTES
#error "NDDMA_PADDING_SOURCE_BYTES is required"
#endif
#ifndef NDDMA_PADDING_NEAREST
#define NDDMA_PADDING_NEAREST 0
#endif
#ifndef NDDMA_PADDING_UNIFORM_CONFIG
#define NDDMA_PADDING_UNIFORM_CONFIG 0
#endif
#ifndef NDDMA_PADDING_CONSTANT_VALUE
#define NDDMA_PADDING_CONSTANT_VALUE 0
#endif
#ifndef NDDMA_PADDING_MAX_LOOP0
#define NDDMA_PADDING_MAX_LOOP0 0
#endif

#if NDDMA_PADDING_BITS == 8
using NdDmaPaddingElement = uint8_t;
#elif NDDMA_PADDING_BITS == 16
using NdDmaPaddingElement = half;
#elif NDDMA_PADDING_BITS == 32
using NdDmaPaddingElement = float;
#else
#error "NDDMA_PADDING_BITS must be 8, 16, or 32"
#endif

namespace {

constexpr uint32_t kDimensionCount = 2;
constexpr uint64_t kSourceStride0 = 1;
constexpr uint64_t kSourceStride1 = 8;
constexpr uint32_t kLoopSize0 = 4;
#if NDDMA_PADDING_MAX_LOOP0 == 1
constexpr uint32_t kLoopSize1 = 1;
constexpr uint8_t kLoop0LeftPadding = 255;
constexpr uint8_t kLoop0RightPadding = 255;
constexpr uint8_t kLoop1LeftPadding = 0;
constexpr uint8_t kLoop1RightPadding = 0;
#else
constexpr uint32_t kLoopSize1 = 3;
constexpr uint8_t kLoop0LeftPadding = 2;
constexpr uint8_t kLoop0RightPadding = 1;
constexpr uint8_t kLoop1LeftPadding = 1;
constexpr uint8_t kLoop1RightPadding = 2;
#endif
constexpr uint64_t kMaxSourceElementOffset =
    (kLoopSize0 - 1) * kSourceStride0 + (kLoopSize1 - 1) * kSourceStride1;
constexpr size_t kExpectedGmAccessEndBytes =
    (kMaxSourceElementOffset + 1) * sizeof(NdDmaPaddingElement);

#if NDDMA_PADDING_MAX_LOOP0 == 1
static_assert(kMaxSourceElementOffset == 3, "unexpected maximum-padding NDDMA source extent");
#else
static_assert(kMaxSourceElementOffset == 19, "unexpected NDDMA padding source extent");
#endif
static_assert(NDDMA_PADDING_SOURCE_BYTES > 0, "NDDMA padding source allocation must be nonzero");

} // namespace

extern "C" __vector__ __global__ void NdDmaPaddingMemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* output, __gm__ uint8_t* guard)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<NdDmaPaddingElement> sourceGm;
    sourceGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ NdDmaPaddingElement*>(source),
        NDDMA_PADDING_SOURCE_BYTES / sizeof(NdDmaPaddingElement));

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<NdDmaPaddingElement> local = allocator.Alloc<NdDmaPaddingElement, 1024>();
    const AscendC::NdDmaLoopInfo<kDimensionCount> loopInfo{
        {kSourceStride0, kSourceStride1},
        {1, 16},
        {kLoopSize0, kLoopSize1},
        {kLoop0LeftPadding, kLoop1LeftPadding},
        {kLoop0RightPadding, kLoop1RightPadding}};
    const AscendC::NdDmaParams<NdDmaPaddingElement, kDimensionCount> params{
        loopInfo, static_cast<NdDmaPaddingElement>(NDDMA_PADDING_CONSTANT_VALUE)};

    AscendC::NdDmaDci();
#if NDDMA_PADDING_UNIFORM_CONFIG == 1
    static constexpr AscendC::NdDmaConfig config = {NDDMA_PADDING_NEAREST != 0, 3, 4, false};
#else
    static constexpr AscendC::NdDmaConfig config = {NDDMA_PADDING_NEAREST != 0};
#endif
    AscendC::DataCopy<NdDmaPaddingElement, kDimensionCount, config>(local, sourceGm, params);
    AscendC::PipeBarrier<PIPE_ALL>();
    (void)output;
    (void)guard;
}

int main()
{
    std::printf(
        "NDDMA_PADDING_BITS=%d NDDMA_PADDING_MODE=%s NDDMA_PADDING_CONFIG=%s "
        "NDDMA_PADDING_CONSTANT_VALUE=%d NDDMA_LOOP_SIZES=[%u,%u,1,1,1] "
        "NDDMA_SOURCE_STRIDES=[1,8,0,0,0] NDDMA_MAX_GM_ELEMENT_OFFSET=%llu "
        "NDDMA_EXPECTED_GM_ACCESS_END_BYTES=%zu NDDMA_ALLOCATED_GM_BYTES=%zu "
        "NDDMA_EXPECTED_RESULT=%s\n",
        NDDMA_PADDING_BITS, NDDMA_PADDING_NEAREST != 0 ? "nearest" : "constant",
        NDDMA_PADDING_UNIFORM_CONFIG != 0 ? "uniform" : "per_dimension", NDDMA_PADDING_CONSTANT_VALUE,
        kLoopSize0, kLoopSize1, static_cast<unsigned long long>(kMaxSourceElementOffset), kExpectedGmAccessEndBytes,
        static_cast<size_t>(NDDMA_PADDING_SOURCE_BYTES),
        NDDMA_PADDING_SOURCE_BYTES >= kExpectedGmAccessEndBytes ? "normal" : "oob");
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(NDDMA_PADDING_SOURCE_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(
        aclrtMalloc(reinterpret_cast<void**>(&first), NDDMA_PADDING_SOURCE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        first, NDDMA_PADDING_SOURCE_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    NdDmaPaddingMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
