/*!
 * \file datacopy_api_memory_case.asc
 * \brief API-level GM memory-access cases for dav-3510 DataCopyPad and format conversion.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef DEVICE_API_CASE_KIND
#error "DEVICE_API_CASE_KIND is required"
#endif
#ifndef DEVICE_API_CASE_GM_BYTES
#error "DEVICE_API_CASE_GM_BYTES is required"
#endif

static_assert(DEVICE_API_CASE_KIND >= 1 && DEVICE_API_CASE_KIND <= 6,
    "DEVICE_API_CASE_KIND must be in [1, 6]");
static_assert(DEVICE_API_CASE_GM_BYTES > 0, "DEVICE_API_CASE_GM_BYTES must be nonzero");

namespace {

constexpr uint32_t kDirectFootprintBytes = 175;
constexpr uint32_t kNz2NdFootprintBytes = 160;
constexpr uint32_t kCompanionBytes = 32;
constexpr uint32_t kGuardBytes = 32;

#if DEVICE_API_CASE_KIND == 1 || DEVICE_API_CASE_KIND == 2 || DEVICE_API_CASE_KIND == 5
constexpr bool kGmIsSource = true;
constexpr uint32_t kFirstBytes = DEVICE_API_CASE_GM_BYTES;
constexpr uint32_t kSecondBytes = kCompanionBytes;
#else
constexpr bool kGmIsSource = false;
constexpr uint32_t kFirstBytes = kCompanionBytes;
constexpr uint32_t kSecondBytes = DEVICE_API_CASE_GM_BYTES;
#endif

#if DEVICE_API_CASE_KIND == 6
constexpr uint32_t kExpectedGmAccessEndBytes = kNz2NdFootprintBytes;
#else
constexpr uint32_t kExpectedGmAccessEndBytes = kDirectFootprintBytes;
#endif

#if DEVICE_API_CASE_KIND == 1 || DEVICE_API_CASE_KIND == 2 || DEVICE_API_CASE_KIND == 5
constexpr uint32_t kExpectedPrimaryInstrId = 84;
#else
constexpr uint32_t kExpectedPrimaryInstrId = 83;
#endif

} // namespace

extern "C" __vector__ __global__ void DataCopyApiMemoryCaseKernel(
    __gm__ uint8_t* first, __gm__ uint8_t* second, __gm__ uint8_t* guard)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint8_t> firstGm;
    AscendC::GlobalTensor<uint8_t> secondGm;
    firstGm.SetGlobalBuffer(first, kFirstBytes);
    secondGm.SetGlobalBuffer(second, kSecondBytes);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<uint8_t> local = allocator.Alloc<uint8_t, 16384>();

#if DEVICE_API_CASE_KIND == 1 || DEVICE_API_CASE_KIND == 2
    // GM block heads are 0, 64, and 128 bytes; each block accesses 47 bytes.
    const AscendC::DataCopyExtParams copyParams{3, 47, 17, 1, 0};
    const AscendC::DataCopyPadExtParams<uint8_t> padParams{true, 3, 5, 0};
#if DEVICE_API_CASE_KIND == 1
    AscendC::DataCopyPad<uint8_t, AscendC::PaddingMode::Normal>(local, firstGm, copyParams, padParams);
#else
    AscendC::DataCopyPad<uint8_t, AscendC::PaddingMode::Compact>(local, firstGm, copyParams, padParams);
#endif
#elif DEVICE_API_CASE_KIND == 3 || DEVICE_API_CASE_KIND == 4
    AscendC::Duplicate<uint8_t>(local, static_cast<uint8_t>(0), 4096);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    // GM block heads are 0, 64, and 128 bytes; each block accesses 47 bytes.
    const AscendC::DataCopyExtParams copyParams{3, 47, 1, 17, 0};
#if DEVICE_API_CASE_KIND == 3
    AscendC::DataCopyPad<uint8_t, AscendC::PaddingMode::Normal>(secondGm, local, copyParams);
#else
    AscendC::DataCopyPad<uint8_t, AscendC::PaddingMode::Compact>(secondGm, local, copyParams);
#endif
#elif DEVICE_API_CASE_KIND == 5
    // dValue=47 is lowered into 32-byte and 15-byte GM-to-UB DataCopyPad operations.
    // The 3510 software lowering adds dstNzMatrixStride directly to the UB
    // pointer, so keep it 32-byte aligned even though ndNum is one.
    const AscendC::Nd2NzParams copyParams{1, 3, 47, 0, 64, 4, 32, 32};
    AscendC::DataCopy(local, firstGm, copyParams);
#else
    AscendC::Duplicate<uint8_t>(local, static_cast<uint8_t>(0), 4096);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    // dValue=32 is lowered into two 16-byte UB-to-GM DataCopyPad operations.
    // srcNStride is in C0 units; four C0s keep the second UB source aligned.
    const AscendC::Nz2NdParamsFull copyParams{1, 3, 32, 1, 4, 64, 160};
    AscendC::DataCopy(secondGm, local, copyParams);
#endif

    AscendC::PipeBarrier<PIPE_ALL>();
    (void)guard;
}

int main()
{
    std::printf("DEVICE_API_CASE_KIND=%d\n", DEVICE_API_CASE_KIND);
    std::printf("DEVICE_API_CASE_GM_ROLE=%s\n", kGmIsSource ? "source" : "destination");
    std::printf("DEVICE_API_CASE_GM_BYTES=%u\n", static_cast<unsigned>(DEVICE_API_CASE_GM_BYTES));
    std::printf("DEVICE_EXPECTED_PRIMARY_INSTR_ID=%u\n", kExpectedPrimaryInstrId);
    std::printf("DEVICE_EXPECTED_GM_ACCESS_END_BYTES=%u\n", kExpectedGmAccessEndBytes);
    std::printf("DEVICE_EXPECTED_RESULT=%s\n",
        DEVICE_API_CASE_GM_BYTES < kExpectedGmAccessEndBytes ? "out_of_bounds" : "normal");

    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(kFirstBytes, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), kFirstBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), kSecondBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), kGuardBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, kFirstBytes, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    DataCopyApiMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
