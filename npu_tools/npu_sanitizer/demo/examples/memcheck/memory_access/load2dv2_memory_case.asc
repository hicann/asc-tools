/*!
 * \file load2dv2_memory_case.asc
 * \brief Generate MTE2_SRC_PARA and LOAD_OUT_TO_L1_2DV2 for sanitizer memory-access validation.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <limits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef LOAD2DV2_SRC_STRIDE
#define LOAD2DV2_SRC_STRIDE 4
#endif

#ifndef LOAD2DV2_M_START_POSITION
#define LOAD2DV2_M_START_POSITION 2
#endif

#ifndef LOAD2DV2_K_START_POSITION
#define LOAD2DV2_K_START_POSITION 1
#endif

#ifndef LOAD2DV2_M_STEP
#define LOAD2DV2_M_STEP 2
#endif

#ifndef LOAD2DV2_K_STEP
#define LOAD2DV2_K_STEP 2
#endif

#ifndef LOAD2DV2_SOURCE_ALLOCATION_BYTES
#define LOAD2DV2_SOURCE_ALLOCATION_BYTES 8192
#endif

#ifndef LOAD2DV2_DST_STRIDE
#define LOAD2DV2_DST_STRIDE 1
#endif

namespace {

constexpr int32_t kDeviceId = 0;
constexpr int32_t kStreamTimeoutMs = 10000;
constexpr uint32_t kL1WorkspaceBytes = 64U * 1024U;
constexpr int64_t kSourceStride = LOAD2DV2_SRC_STRIDE;
constexpr uint32_t kMStartPosition = LOAD2DV2_M_START_POSITION;
constexpr uint32_t kKStartPosition = LOAD2DV2_K_START_POSITION;
constexpr uint16_t kMStep = LOAD2DV2_M_STEP;
constexpr uint16_t kKStep = LOAD2DV2_K_STEP;
constexpr uint16_t kDestinationStride = LOAD2DV2_DST_STRIDE;
constexpr size_t kSourceAllocationBytes = LOAD2DV2_SOURCE_ALLOCATION_BYTES;

static_assert(
    kSourceStride >= std::numeric_limits<int32_t>::min() &&
        kSourceStride <= std::numeric_limits<int32_t>::max(),
    "LOAD2DV2_SRC_STRIDE must fit in int32_t");
static_assert(
    LOAD2DV2_M_START_POSITION >= 0 && kMStartPosition == LOAD2DV2_M_START_POSITION,
    "LOAD2DV2_M_START_POSITION must fit in uint32_t");
static_assert(
    LOAD2DV2_K_START_POSITION >= 0 && kKStartPosition == LOAD2DV2_K_START_POSITION,
    "LOAD2DV2_K_START_POSITION must fit in uint32_t");
static_assert(kMStep == LOAD2DV2_M_STEP && kMStep <= 0x0fffU, "LOAD2DV2_M_STEP must fit in 12 bits");
static_assert(kKStep == LOAD2DV2_K_STEP && kKStep <= 0x0fffU, "LOAD2DV2_K_STEP must fit in 12 bits");
static_assert(
    kDestinationStride == LOAD2DV2_DST_STRIDE && kDestinationStride <= 0x0fffU,
    "LOAD2DV2_DST_STRIDE must fit in 12 bits");
static_assert(LOAD2DV2_SOURCE_ALLOCATION_BYTES > 0, "LOAD2DV2_SOURCE_ALLOCATION_BYTES must be positive");

bool CheckAclResult(aclError result, const char* apiName)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: result=%d\n", apiName, result);
    return false;
}

} // namespace

extern "C" __global__ __cube__ void Load2DV2MemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* output, __gm__ uint8_t* guard)
{
    __cbuf__ uint8_t l1Workspace[kL1WorkspaceBytes];

    const uint64_t sourceStrideConfig = static_cast<uint64_t>(static_cast<uint32_t>(kSourceStride));
    set_mte2_src_para(sourceStrideConfig);
    asc_copy_gm2l1(
        reinterpret_cast<__cbuf__ void*>(l1Workspace), reinterpret_cast<__gm__ void*>(source), kMStartPosition,
        kKStartPosition, kDestinationStride, kMStep, kKStep, 0, 0);
    (void)output;
    (void)guard;
}

int RunSample()
{
    aclrtStream stream = nullptr;
    uint8_t* sourceDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    bool runSucceeded = false;

    do {
        if (!CheckAclResult(aclInit(nullptr), "aclInit")) {
            break;
        }
        aclInitialized = true;
        if (!CheckAclResult(aclrtSetDevice(kDeviceId), "aclrtSetDevice")) {
            break;
        }
        deviceSet = true;
        if (!CheckAclResult(aclrtCreateStream(&stream), "aclrtCreateStream")) {
            break;
        }
        if (!CheckAclResult(
                aclrtMalloc(
                    reinterpret_cast<void**>(&sourceDevice), kSourceAllocationBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc")) {
            break;
        }

        if (!CheckAclResult(
                aclrtMemset(sourceDevice, kSourceAllocationBytes, 0, kSourceAllocationBytes), "aclrtMemset")) {
            break;
        }

        Load2DV2MemoryCaseKernel<<<1, 0, stream>>>(sourceDevice, sourceDevice, sourceDevice);
        const aclError syncResult = aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
        std::printf("DEVICE_SYNC_RESULT=%d\n", syncResult);
        runSucceeded = CheckAclResult(syncResult, "aclrtSynchronizeStreamWithTimeout");
    } while (false);

    bool cleanupSucceeded = true;
    if (sourceDevice != nullptr) {
        cleanupSucceeded = CheckAclResult(aclrtFree(sourceDevice), "aclrtFree") && cleanupSucceeded;
    }
    if (stream != nullptr) {
        cleanupSucceeded = CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") && cleanupSucceeded;
    }
    if (deviceSet) {
        cleanupSucceeded = CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") && cleanupSucceeded;
    }
    if (aclInitialized) {
        cleanupSucceeded = CheckAclResult(aclFinalize(), "aclFinalize") && cleanupSucceeded;
    }
    return runSucceeded && cleanupSucceeded ? 0 : 1;
}

int main() { return RunSample(); }
