/*!
 * \file fixpipe_c0pad_memory_case.asc
 * \brief dav-3510 DumpTensor L0C-to-GM raw Fixpipe path with C0 padding enabled.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef FIXPIPE_C0PAD_N_SIZE
#error "FIXPIPE_C0PAD_N_SIZE is required"
#endif
#ifndef FIXPIPE_C0PAD_OUTPUT_BYTES
#error "FIXPIPE_C0PAD_OUTPUT_BYTES is required"
#endif

static_assert(FIXPIPE_C0PAD_N_SIZE == 16 || FIXPIPE_C0PAD_N_SIZE == 32, "unsupported C0-pad test size");

constexpr uint32_t kFixpipeC0PadExpectedBytes = FIXPIPE_C0PAD_N_SIZE * 16U * sizeof(float);

extern "C" __cube__ __global__ void FixpipeC0PadMemoryCaseKernel(
    __gm__ uint8_t*, __gm__ uint8_t*, __gm__ uint8_t* output)
{
    asc_init();
    __cc__ float source[512];
    __ca__ half aL0[256];
    __cb__ half bL0[512];
    asc_mmad(source, aL0, bL0, 16, FIXPIPE_C0PAD_N_SIZE, 16, 0, false, false, true);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    copy_matrix_cc_to_gm(
        reinterpret_cast<__gm__ float*>(output), source, 0, FIXPIPE_C0PAD_N_SIZE, 16, 256, 16, 0, 0, 0,
        static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false, false,
        static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, false, 0, false, false, true, false, false, false);
    pipe_barrier(PIPE_ALL);
}

int main()
{
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(32, 1);

    std::printf(
        "FIXPIPE_C0PAD_N_SIZE=%u FIXPIPE_C0PAD_EXPECTED_GM_BYTES=%u FIXPIPE_C0PAD_ALLOCATED_GM_BYTES=%u\n",
        FIXPIPE_C0PAD_N_SIZE, kFixpipeC0PadExpectedBytes, FIXPIPE_C0PAD_OUTPUT_BYTES);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(
        aclrtMalloc(reinterpret_cast<void**>(&third), FIXPIPE_C0PAD_OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, 32, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    FixpipeC0PadMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    if (!CheckAclResult(syncResult, "aclrtSynchronizeStream(stream)")) {
        status = 1;
    }

cleanup:
    if (first != nullptr && !CheckAclResult(aclrtFree(first), "aclrtFree(first)")) {
        status = 1;
    }
    if (second != nullptr && !CheckAclResult(aclrtFree(second), "aclrtFree(second)")) {
        status = 1;
    }
    if (third != nullptr && !CheckAclResult(aclrtFree(third), "aclrtFree(third)")) {
        status = 1;
    }
    if (stream != nullptr && !CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)")) {
        status = 1;
    }
    if (deviceSet && !CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)")) {
        status = 1;
    }
    if (aclInitialized && !CheckAclResult(aclFinalize(), "aclFinalize()")) {
        status = 1;
    }
    return status;
}
