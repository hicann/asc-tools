/*!
 * \file multi_memory_case.asc
 * \brief Parameterized GM-to-L1 ND2NZ and DN2NZ memory-access cases.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef DEVICE_CASE_MULTI_KIND
#error "DEVICE_CASE_MULTI_KIND is required"
#endif
#ifndef DEVICE_CASE_SOURCE_BYTES
#error "DEVICE_CASE_SOURCE_BYTES is required"
#endif
#ifndef DEVICE_CASE_DATA_BITS
#define DEVICE_CASE_DATA_BITS 16
#endif
#ifndef DEVICE_CASE_MATRIX_NUM
#define DEVICE_CASE_MATRIX_NUM 1
#endif
#ifndef DEVICE_CASE_SOURCE_MATRIX_STRIDE_ELEMENTS
#define DEVICE_CASE_SOURCE_MATRIX_STRIDE_ELEMENTS 0
#endif
#ifndef DEVICE_CASE_DESTINATION_MATRIX_STRIDE_ELEMENTS
#define DEVICE_CASE_DESTINATION_MATRIX_STRIDE_ELEMENTS 0
#endif

static_assert(
    DEVICE_CASE_MULTI_KIND == 1 || DEVICE_CASE_MULTI_KIND == 2,
    "DEVICE_CASE_MULTI_KIND must be 1 (ND2NZ) or 2 (DN2NZ)");
static_assert(
    DEVICE_CASE_DATA_BITS == 8 || DEVICE_CASE_DATA_BITS == 16 || DEVICE_CASE_DATA_BITS == 32,
    "DEVICE_CASE_DATA_BITS must be 8, 16, or 32");
static_assert(DEVICE_CASE_MATRIX_NUM > 0, "DEVICE_CASE_MATRIX_NUM must be nonzero");
static_assert(DEVICE_CASE_SOURCE_BYTES > 0, "DEVICE_CASE_SOURCE_BYTES must be nonzero");

#if DEVICE_CASE_DATA_BITS == 8
using DeviceCaseDataType = uint8_t;
constexpr uint32_t kInstructionWidthOffset = 0U;
#elif DEVICE_CASE_DATA_BITS == 16
using DeviceCaseDataType = half;
constexpr uint32_t kInstructionWidthOffset = 1U;
#else
using DeviceCaseDataType = float;
constexpr uint32_t kInstructionWidthOffset = 2U;
#endif

static_assert(
    DEVICE_CASE_SOURCE_BYTES % sizeof(DeviceCaseDataType) == 0,
    "DEVICE_CASE_SOURCE_BYTES must contain a whole number of source elements");

constexpr uint32_t kExpectedInstructionId =
    (DEVICE_CASE_MULTI_KIND == 1 ? 77U : 80U) + kInstructionWidthOffset;
constexpr uint32_t kDnNValue = 4;
constexpr uint32_t kDnDValue = 16;
constexpr uint32_t kDnSourceDValue = 16;
constexpr uint32_t kDnSourceFootprintBytes =
    (DEVICE_CASE_MATRIX_NUM - 1) * DEVICE_CASE_SOURCE_MATRIX_STRIDE_ELEMENTS * sizeof(DeviceCaseDataType) +
    (kDnDValue - 1) * kDnSourceDValue * sizeof(DeviceCaseDataType) +
    kDnNValue * sizeof(DeviceCaseDataType);

extern "C" __cube__ __global__ void MultiMemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* output, __gm__ uint8_t* guard)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<DeviceCaseDataType> sourceGm;
    sourceGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ DeviceCaseDataType*>(source), DEVICE_CASE_SOURCE_BYTES / sizeof(DeviceCaseDataType));

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> allocator;
    AscendC::LocalTensor<DeviceCaseDataType> local =
        allocator.Alloc<AscendC::TPosition::A1, DeviceCaseDataType>(4096);
#if DEVICE_CASE_MULTI_KIND == 1
    const AscendC::Nd2NzParams params{2, 4, 16, 256, 32, 4, 1, 2048};
#else
    const AscendC::Dn2NzParams params{
        DEVICE_CASE_MATRIX_NUM, kDnNValue, kDnDValue, DEVICE_CASE_SOURCE_MATRIX_STRIDE_ELEMENTS,
        kDnSourceDValue, 4, 1, DEVICE_CASE_DESTINATION_MATRIX_STRIDE_ELEMENTS};
#endif
    // On dav-3510, this API emits SET_MTE2_NZ_PARA (ID 399) before the
    // dtype-specific ND2NZ/DN2NZ transfer instruction.
    AscendC::DataCopy(local, sourceGm, params);
    AscendC::PipeBarrier<PIPE_ALL>();
    (void)output;
    (void)guard;
}

int main()
{
    std::printf("DEVICE_EXPECTED_INSTR_ID=%u\n", kExpectedInstructionId);
#if DEVICE_CASE_MULTI_KIND == 2
    std::printf(
        "MULTI_DN_MATRIX_NUM=%d MULTI_DN_EXPECTED_GM_FOOTPRINT_BYTES=%u "
        "MULTI_DN_ALLOCATED_GM_BYTES=%d\n",
        DEVICE_CASE_MATRIX_NUM, kDnSourceFootprintBytes, DEVICE_CASE_SOURCE_BYTES);
#endif
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(DEVICE_CASE_SOURCE_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), DEVICE_CASE_SOURCE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, DEVICE_CASE_SOURCE_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    MultiMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
