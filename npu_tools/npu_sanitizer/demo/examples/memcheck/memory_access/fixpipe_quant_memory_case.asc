/*!
 * \file fixpipe_quant_memory_case.asc
 * \brief CCE-intrinsic-granularity Fixpipe quantization and packed-output case.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef FIXPIPE_QUANT_PRE
#error "FIXPIPE_QUANT_PRE is required"
#endif
#ifndef FIXPIPE_SOURCE_KIND
#error "FIXPIPE_SOURCE_KIND is required"
#endif
#ifndef FIXPIPE_DEST_KIND
#error "FIXPIPE_DEST_KIND is required"
#endif
#ifndef FIXPIPE_EXPECTED_OUTPUT_BYTES
#error "FIXPIPE_EXPECTED_OUTPUT_BYTES is required"
#endif
#ifndef FIXPIPE_EXPECTED_INSTRUCTION_ID
#error "FIXPIPE_EXPECTED_INSTRUCTION_ID is required"
#endif

#ifndef FIXPIPE_N_SIZE
#define FIXPIPE_N_SIZE 16
#endif
#ifndef FIXPIPE_M_SIZE
#define FIXPIPE_M_SIZE 16
#endif
#ifndef FIXPIPE_DST_STRIDE
#define FIXPIPE_DST_STRIDE 16
#endif
#ifndef FIXPIPE_CHANNEL_SPLIT
#define FIXPIPE_CHANNEL_SPLIT 0
#endif
#ifndef FIXPIPE_LAYOUT
#define FIXPIPE_LAYOUT 0
#endif
#ifndef FIXPIPE_UNIT_FLAG
#define FIXPIPE_UNIT_FLAG 0
#endif
#ifndef FIXPIPE_RELU_PRE
#define FIXPIPE_RELU_PRE 0
#endif
#ifndef FIXPIPE_CLIP_RELU_PRE
#define FIXPIPE_CLIP_RELU_PRE 0
#endif

#if FIXPIPE_SOURCE_KIND == 1
using FixpipeSource = float;
#elif FIXPIPE_SOURCE_KIND == 2
using FixpipeSource = int32_t;
#else
#error "FIXPIPE_SOURCE_KIND must be 1 (float) or 2 (int32_t)"
#endif

#if FIXPIPE_DEST_KIND == 1
using FixpipeDestination = uint8_t;
#elif FIXPIPE_DEST_KIND == 2
using FixpipeDestination = half;
#elif FIXPIPE_DEST_KIND == 3
using FixpipeDestination = bfloat16_t;
#elif FIXPIPE_DEST_KIND == 4
using FixpipeDestination = fp8_e4m3fn_t;
#elif FIXPIPE_DEST_KIND == 5
using FixpipeDestination = hifloat8_t;
#elif FIXPIPE_DEST_KIND == 6
using FixpipeDestination = float;
#elif FIXPIPE_DEST_KIND == 7
using FixpipeDestination = int32_t;
#elif FIXPIPE_DEST_KIND == 8
using FixpipeDestination = int4b_t;
#else
#error "FIXPIPE_DEST_KIND is invalid"
#endif

static_assert(FIXPIPE_EXPECTED_OUTPUT_BYTES > 32, "valid and OOB allocations must remain nonzero");
static_assert(FIXPIPE_LAYOUT >= 0 && FIXPIPE_LAYOUT <= 2, "FIXPIPE_LAYOUT must be NZ, NZ2ND, or NZ2DN");
static_assert(FIXPIPE_CHANNEL_SPLIT == 0 || FIXPIPE_LAYOUT == 0, "channel split requires NZ output");
static_assert(
    FIXPIPE_UNIT_FLAG == 0 || FIXPIPE_SOURCE_KIND == 1, "unit-flag cases use a float L0C accumulator");

constexpr bool kUsesVectorQuant =
    FIXPIPE_QUANT_PRE == 2 || FIXPIPE_QUANT_PRE == 4 || FIXPIPE_QUANT_PRE == 8 || FIXPIPE_QUANT_PRE == 10 ||
    FIXPIPE_QUANT_PRE == 12 || FIXPIPE_QUANT_PRE == 14 || FIXPIPE_QUANT_PRE == 21 || FIXPIPE_QUANT_PRE == 23 ||
    FIXPIPE_QUANT_PRE == 25 || FIXPIPE_QUANT_PRE == 31 || FIXPIPE_QUANT_PRE == 33 || FIXPIPE_QUANT_PRE == 35;
constexpr bool kUsesScalarQuant =
    FIXPIPE_QUANT_PRE == 3 || FIXPIPE_QUANT_PRE == 5 || FIXPIPE_QUANT_PRE == 9 || FIXPIPE_QUANT_PRE == 11 ||
    FIXPIPE_QUANT_PRE == 13 || FIXPIPE_QUANT_PRE == 15 || FIXPIPE_QUANT_PRE == 22 || FIXPIPE_QUANT_PRE == 24 ||
    FIXPIPE_QUANT_PRE == 26 || FIXPIPE_QUANT_PRE == 32 || FIXPIPE_QUANT_PRE == 34 || FIXPIPE_QUANT_PRE == 36;
constexpr bool kUsesVectorRelu = FIXPIPE_RELU_PRE == 3;
constexpr uint32_t kQuantParameterBytes = 128;
constexpr uint32_t kFixpipeQuantAddressGranularity = 128;
constexpr uint32_t kFixpipeReluAddressGranularity = 64;
constexpr uint64_t kScalarQuantParameter =
    0x3f800000ULL | ((FIXPIPE_QUANT_PRE == 22 || FIXPIPE_QUANT_PRE == 26) ? (1ULL << 46) : 0ULL);
constexpr uint64_t kScalarReluAlpha = static_cast<uint64_t>(127U << 10U) << 13U;
constexpr uint64_t kFixpipeMatrixCount = 2;
constexpr uint64_t kFixpipeSourceMatrixStride = 16;
constexpr uint64_t kFixpipeDestinationMatrixStride = 512;

extern "C" __cube__ __global__ void FixpipeQuantMemoryCaseKernel(
    __gm__ uint8_t* quantParameters, __gm__ uint8_t*, __gm__ uint8_t* output)
{
    asc_init();
    __cc__ FixpipeSource source[4096];
    if constexpr (FIXPIPE_UNIT_FLAG != 0) {
        __ca__ half aL0[256];
        __cb__ half bL0[256];
        asc_mmad(
            reinterpret_cast<__cc__ float*>(source), aL0, bL0, 16, 16, 16, 3, false, false, true);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    }
    uint64_t reluAddress = 0;
    uint64_t quantAddress = 0;
    if constexpr (kUsesVectorRelu) {
        __cbuf__ uint64_t reluL1[8];
        __fbuf__ uint64_t reluFbuf[8];
        asc_copy_gm2l1(
            reinterpret_cast<__cbuf__ void*>(reluL1), reinterpret_cast<__gm__ void*>(quantParameters), 1, 2, 0, 0,
            0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb(
            reinterpret_cast<__fbuf__ void*>(reluFbuf), reinterpret_cast<__cbuf__ void*>(reluL1), 1, 2, 0, 0);
        reluAddress =
            static_cast<uint64_t>(reinterpret_cast<uintptr_t>(reluFbuf)) / kFixpipeReluAddressGranularity;
    } else if constexpr (FIXPIPE_RELU_PRE == 2) {
        asc_set_l0c2gm_relu_alpha(kScalarReluAlpha);
    }
    if constexpr (kUsesVectorQuant) {
        __cbuf__ uint64_t quantL1[kQuantParameterBytes / sizeof(uint64_t)];
        __fbuf__ uint64_t quantFbuf[kQuantParameterBytes / sizeof(uint64_t)];
        asc_copy_gm2l1(
            reinterpret_cast<__cbuf__ void*>(quantL1), reinterpret_cast<__gm__ void*>(quantParameters), 1, 4, 0, 0,
            0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb(
            reinterpret_cast<__fbuf__ void*>(quantFbuf), reinterpret_cast<__cbuf__ void*>(quantL1), 1, 2, 0, 0);
        quantAddress =
            static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quantFbuf)) / kFixpipeQuantAddressGranularity;
    } else if constexpr (kUsesScalarQuant) {
        asc_set_l0c_copy_prequant(kScalarQuantParameter);
    }
    if constexpr (kUsesVectorRelu || kUsesVectorQuant) {
        asc_set_l0c2gm_config(reluAddress, quantAddress, false);
        asc_sync_pipe(PIPE_FIX);
    }
    if constexpr (FIXPIPE_LAYOUT != 0) {
        asc_set_l0c2gm_nz2nd(
            kFixpipeMatrixCount, kFixpipeSourceMatrixStride, kFixpipeDestinationMatrixStride);
    }
    if constexpr (FIXPIPE_LAYOUT == 2) {
        asc_set_l0c2gm_channel_para(1ULL << 48U);
    }
    asc_copy_l0c2gm(
        (__gm__ FixpipeDestination*)output, source, FIXPIPE_N_SIZE, FIXPIPE_M_SIZE, FIXPIPE_DST_STRIDE, 16,
        asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, static_cast<asc_unit_flag_mode>(FIXPIPE_UNIT_FLAG),
        static_cast<asc_quant_mode>(FIXPIPE_QUANT_PRE), static_cast<asc_relu_pre_mode>(FIXPIPE_RELU_PRE),
        FIXPIPE_CHANNEL_SPLIT != 0, FIXPIPE_LAYOUT == 1, FIXPIPE_LAYOUT == 2, FIXPIPE_CLIP_RELU_PRE != 0);
    if constexpr (FIXPIPE_UNIT_FLAG == 2) {
        asc_sync_pipe(PIPE_FIX);
        asc_set_l0c2gm_config(0, 0, true);
    }
    pipe_barrier(PIPE_ALL);
}

int main()
{
    const bool makeOob = std::getenv("NPU_CHECK_MEMORY_CASE_OOB") != nullptr;
    const size_t outputBytes = FIXPIPE_EXPECTED_OUTPUT_BYTES - (makeOob ? 32U : 0U);
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> quantParameters(kQuantParameterBytes, 0);

    std::printf(
        "FIXPIPE_QUANT_PRE=%u FIXPIPE_LAYOUT=%u FIXPIPE_EXPECTED_INSTR_ID=%u FIXPIPE_EXPECTED_GM_BYTES=%u "
        "FIXPIPE_ALLOCATED_GM_BYTES=%zu FIXPIPE_EXPECTED_RESULT=%s\n",
        FIXPIPE_QUANT_PRE, FIXPIPE_LAYOUT, FIXPIPE_EXPECTED_INSTRUCTION_ID, FIXPIPE_EXPECTED_OUTPUT_BYTES, outputBytes,
        makeOob ? "oob" : "valid");

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), kQuantParameterBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        first, kQuantParameterBytes, quantParameters.data(), quantParameters.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    FixpipeQuantMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    if (!CheckAclResult(syncResult, "aclrtSynchronizeStream(stream)")) {
        status = 1;
    }

cleanup:
    if (first != nullptr && !CheckAclResult(aclrtFree(first), "aclrtFree(first)")) {
        status = 1;
    }
    if (second != nullptr && !CheckAclResult(aclrtFree(second), "aclrtFree(second)")) {
        status = 1;
    }
    if (third != nullptr && !CheckAclResult(aclrtFree(third), "aclrtFree(third)")) {
        status = 1;
    }
    if (stream != nullptr && !CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)")) {
        status = 1;
    }
    if (deviceSet && !CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)")) {
        status = 1;
    }
    if (aclInitialized && !CheckAclResult(aclFinalize(), "aclFinalize()")) {
        status = 1;
    }
    return status;
}
