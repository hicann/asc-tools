/*!
 * \file nddma_missing_stride_memory_case.asc
 * \brief Direct NDDMA intrinsic with an intentionally missing active loop0 stride SET.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

namespace {

constexpr size_t kSourceBytes = 1024 * 1024;

} // namespace

extern "C" __vector__ __global__ void NdDmaMissingStrideMemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* output, __gm__ uint8_t* guard)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<uint8_t> local = allocator.Alloc<uint8_t, 64>();

    set_pad_cnt_nddma(0);
    // The API requires all five stride SETs before NDDMA. Configure loop1-loop4,
    // but intentionally omit ID 132 to verify that the whole move is skipped.
    set_loop1_stride_nddma(0);
    set_loop2_stride_nddma(0);
    set_loop3_stride_nddma(0);
    set_loop4_stride_nddma(0);
    set_pcie_rd_ctrl(0);
    nddma_out_to_ub_b8(
        reinterpret_cast<__ubuf__ void*>(local.GetPhyAddr()), reinterpret_cast<__gm__ void*>(source), 0,
        2, 1, 1, 1, 1, 0, 0, true, 0);
    AscendC::PipeBarrier<PIPE_ALL>();
    (void)output;
    (void)guard;
}

int main()
{
    std::printf(
        "NDDMA_MISSING_ACTIVE_STRIDE=loop0 NDDMA_REQUIRED_SET_INSTR_ID=132 "
        "NDDMA_LOOP_SIZES=[2,1,1,1,1] NDDMA_ALLOCATED_GM_BYTES=%zu\n",
        kSourceBytes);

    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(kSourceBytes, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), kSourceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, kSourceBytes, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    NdDmaMissingStrideMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
