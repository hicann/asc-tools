/*! \file split_wrong_side_mutex_noop.asc */

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __global__ __mix__(1, 1) void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    constexpr uint8_t mutexId = 0;

    if ASCEND_IS_AIC {
        // Scenario: the AIC branch calls the AIV-only V mutex, which split filtering treats as a no-op.
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
    }
    if ASCEND_IS_AIV {
        // Scenario: the AIV branch calls the AIC-only M mutex, which split filtering treats as a no-op.
        AscendC::Mutex::Lock<PIPE_M>(mutexId);
        AscendC::Mutex::Unlock<PIPE_M>(mutexId);
    }
}

int RunSample()
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<1, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
