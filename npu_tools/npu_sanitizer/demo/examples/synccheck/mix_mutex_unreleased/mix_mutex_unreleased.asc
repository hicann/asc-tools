/*! \file mix_mutex_unreleased.asc */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __global__ __mix__(1, 2) void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    constexpr uint8_t mutexId = 0;

    if ASCEND_IS_AIC {
        // Scenario: the mix kernel's AIC M pipeline acquires a mutex without releasing it.
        asc_lock(PIPE_M, mutexId);
    }
    if ASCEND_IS_AIV {
        // Scenario: both AIV V pipelines acquire the same mutex ID without releasing it.
        asc_lock(PIPE_V, mutexId);
    }
}

int RunSample(uint32_t blockCount = 1)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
