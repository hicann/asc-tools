/*! \file multi_launch_unconsumed.asc */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __vector__ __global__ __aicore__ void synccheck_demo_kernel(int32_t eventId)
{
    AscendC::InitSocState();

    // Scenario: each launch leaves its event-specific SET_FLAG unconsumed.
    asc_sync_notify(PIPE_V, PIPE_MTE2, eventId);
}

int RunSample(uint32_t blockCount = 1)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>(EVENT_ID0);
    synccheck_demo_kernel<<<blockCount, 0, stream>>>(EVENT_ID1);
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
