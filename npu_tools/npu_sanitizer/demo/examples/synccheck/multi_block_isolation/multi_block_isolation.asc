/*! \file multi_block_isolation.asc */

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 5000;
} // namespace

extern "C" __vector__ __global__ __aicore__ void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    // Scenario: block 0 consumes its flag, while block 1 leaves the same key unconsumed.
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
    if (AscendC::GetBlockIdx() == 0) {
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
    }
}

int RunSample(uint32_t blockCount = 2)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
