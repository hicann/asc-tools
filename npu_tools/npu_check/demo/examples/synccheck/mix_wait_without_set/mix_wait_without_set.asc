/*! \file mix_wait_without_set.asc */

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr int32_t kStreamTimeoutMs = 10000;
} // namespace

extern "C" __global__ __mix__(1, 1) void synccheck_demo_kernel()
{
    AscendC::InitSocState();

    if ASCEND_IS_AIC {
        // Scenario: the mix kernel's AIC M pipeline waits without a matching SET_FLAG.
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
    }
    if ASCEND_IS_AIV {
        // Scenario: both AIV V pipelines wait without matching SET_FLAG operations.
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    }
}

int RunSample(uint32_t blockCount = 1)
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    synccheck_demo_kernel<<<blockCount, 0, stream>>>();
    aclrtSynchronizeStreamWithTimeout(stream, kStreamTimeoutMs);
    // Force destruction keeps teardown bounded for unmatched WAIT_FLAG operations.
    aclrtDestroyStreamForce(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

int main() { return RunSample(); }
