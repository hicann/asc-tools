#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"
#include <array>
#include <cstdio>
#include <cstring>

#define CHECK(call) do { const auto status = (call); if (status != ACL_SUCCESS) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, status); return 1; } } while (false)

template<bool SyncError>
__vector__ __global__ __aicore__ void Composite(__gm__ float* input, __gm__ float* output)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> src, dst;
    src.SetGlobalBuffer(input);
    dst.SetGlobalBuffer(output, 24);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto local = allocator.Alloc<float, 24>();
    // Reads [0,32), [48,80), [96,128); only the last burst exceeds a 112-byte allocation.
    AscendC::DataCopyExtParams params{3, 32, 16, 0, 0};
    AscendC::DataCopyPadExtParams<float> padding{false, 0, 0, 0};
    AscendC::DataCopyPad(local, src, params, padding);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(dst, local, 24);
    AscendC::PipeBarrier<PIPE_ALL>();
    if constexpr (SyncError) asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID7);
}

int main(int argc, char** argv)
{
    if (argc != 2) return 2;
    const bool valid = std::strcmp(argv[1], "valid") == 0;
    const bool mem = std::strcmp(argv[1], "mem_only") == 0;
    const bool sync = std::strcmp(argv[1], "sync_only") == 0;
    const bool both = std::strcmp(argv[1], "both") == 0;
    const bool repeated = std::strcmp(argv[1], "same_stream") == 0;
    const bool streams = std::strcmp(argv[1], "multi_stream") == 0;
    if (!(valid || mem || sync || both || repeated || streams)) return 2;
    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtStream first{}, second{};
    CHECK(aclrtCreateStream(&first));
    CHECK(aclrtCreateStream(&second));
    float *input{}, *output{}, *validInput{}, *validOutput{};
    const size_t inputBytes = (mem || both || repeated || streams) ? 112 : 128;
    CHECK(aclrtMalloc(reinterpret_cast<void**>(&input), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(reinterpret_cast<void**>(&output), 96, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(reinterpret_cast<void**>(&validInput), 128, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(reinterpret_cast<void**>(&validOutput), 96, ACL_MEM_MALLOC_HUGE_FIRST));
    std::array<float, 32> host;
    host.fill(1.0F);
    CHECK(aclrtMemcpy(input, inputBytes, host.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(validInput, 128, host.data(), 128, ACL_MEMCPY_HOST_TO_DEVICE));
    if (valid || mem) Composite<false><<<1, 0, first>>>(input, output);
    else Composite<true><<<1, 0, first>>>(input, output);
    if (repeated) Composite<true><<<1, 0, first>>>(input, output);
    if (streams) Composite<false><<<1, 0, second>>>(validInput, validOutput);
    CHECK(aclrtSynchronizeStreamWithTimeout(first, 10000));
    if (streams) CHECK(aclrtSynchronizeStreamWithTimeout(second, 10000));
    std::array<float, 24> result{};
    CHECK(aclrtMemcpy(result.data(), 96, output, 96, ACL_MEMCPY_DEVICE_TO_HOST));
    // OOB contents are unspecified; verify only the elements read inside the allocation.
    const size_t checked = inputBytes == 128 ? 24 : 20;
    for (size_t i = 0; i < checked; ++i) if (result[i] != 1.0F) return 3;
    if (streams) {
        CHECK(aclrtMemcpy(result.data(), 96, validOutput, 96, ACL_MEMCPY_DEVICE_TO_HOST));
        for (float value : result) if (value != 1.0F) return 3;
    }
    CHECK(aclrtFree(input));
    CHECK(aclrtFree(output));
    CHECK(aclrtFree(validInput));
    CHECK(aclrtFree(validOutput));
    CHECK(aclrtDestroyStream(first));
    CHECK(aclrtDestroyStream(second));
    CHECK(aclrtResetDevice(0));
    CHECK(aclFinalize());
    std::printf("COMPOSITE_RESULT case=%s checked_elements=%zu result=pass\n", argv[1], checked + (streams ? 24 : 0));
    return 0;
}
