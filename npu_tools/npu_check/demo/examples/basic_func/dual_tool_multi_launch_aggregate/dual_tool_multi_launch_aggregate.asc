#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {

constexpr uint32_t kBurstCount = 3;
constexpr uint32_t kBurstBytes = 32;
constexpr int64_t kSourceGapBytes = 16;
constexpr uint32_t kCopiedElements = kBurstCount * kBurstBytes / sizeof(float);
constexpr uint32_t kAllocationElements = 28;
constexpr size_t kAllocationBytes = kAllocationElements * sizeof(float);
constexpr int32_t kDeviceId = 0;
constexpr int32_t kKernelTimeoutMs = 10000;

} // namespace

#define ACL_CHECK(apiCall)                                                                                         \
    do {                                                                                                           \
        const aclError result = (apiCall);                                                                         \
        if (result != ACL_SUCCESS) {                                                                               \
            std::fprintf(stderr, "%s failed: result=%d\n", #apiCall, result);                                      \
            return 1;                                                                                              \
        }                                                                                                          \
    } while (false)

extern "C" __vector__ __global__ __aicore__ void InvalidGmRead(__gm__ float* input)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> inputGm;
    inputGm.SetGlobalBuffer(input, kAllocationElements);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> inputLocal = ubAllocator.Alloc<float, kCopiedElements>();

    // GM bursts are [0, 32), [48, 80), and [96, 128). The final 32-byte read exceeds the allocation.
    const AscendC::DataCopyExtParams copyParams{kBurstCount, kBurstBytes, kSourceGapBytes, 0, 0};
    const AscendC::DataCopyPadExtParams<float> paddingParams{false, 0, 0, 0};
    AscendC::DataCopyPad(inputLocal, inputGm, copyParams, paddingParams);
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" __vector__ __global__ __aicore__ void UnconsumedSetFlag()
{
    AscendC::InitSocState();

    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
}

int32_t main()
{
    const std::vector<float> inputHost(kAllocationElements, 1.0F);
    float* inputDevice = nullptr;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&inputDevice), kAllocationBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(inputDevice, kAllocationBytes, inputHost.data(), kAllocationBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));

    InvalidGmRead<<<1, 0, stream>>>(inputDevice);
    UnconsumedSetFlag<<<1, 0, stream>>>();
    ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, kKernelTimeoutMs));

    ACL_CHECK(aclrtFree(inputDevice));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(kDeviceId));
    ACL_CHECK(aclFinalize());
    return 0;
}
