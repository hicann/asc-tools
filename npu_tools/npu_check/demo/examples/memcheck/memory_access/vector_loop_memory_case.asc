/*!
 * \file vector_loop_memory_case.asc
 * \brief Parameterized dav-3510 GM-to-UB and UB-to-GM outer-loop memory-access cases.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef VECTOR_LOOP_DIRECTION
#error "VECTOR_LOOP_DIRECTION is required"
#endif
#ifndef VECTOR_LOOP_GM_ALLOCATION_BYTES
#error "VECTOR_LOOP_GM_ALLOCATION_BYTES is required"
#endif

static_assert(VECTOR_LOOP_DIRECTION == 1 || VECTOR_LOOP_DIRECTION == 2,
    "VECTOR_LOOP_DIRECTION must be 1 (GM-to-UB) or 2 (UB-to-GM)");
static_assert(VECTOR_LOOP_GM_ALLOCATION_BYTES > 0, "VECTOR_LOOP_GM_ALLOCATION_BYTES must be nonzero");

namespace {

constexpr uint32_t kGmToUb = 1;
constexpr uint32_t kLoop1Size = 2;
constexpr uint32_t kLoop2Size = 3;
constexpr uint64_t kGmLoop1StrideBytes = 64;
constexpr uint64_t kGmLoop2StrideBytes = 192;
constexpr uint64_t kLocalLoop1StrideBytes = 32;
constexpr uint64_t kLocalLoop2StrideBytes = 64;
constexpr uint32_t kAccessBytes = 32;
constexpr uint32_t kGmAccessEndBytes =
    (kLoop2Size - 1) * kGmLoop2StrideBytes + (kLoop1Size - 1) * kGmLoop1StrideBytes + kAccessBytes;
constexpr uint32_t kLocalWorkspaceBytes = 256;

} // namespace

extern "C" __vector__ __global__ void VectorLoopMemoryCaseKernel(
    __gm__ uint8_t* gm, __gm__ uint8_t* unused, __gm__ uint8_t* guard)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<uint8_t> gmTensor;
    gmTensor.SetGlobalBuffer(gm, VECTOR_LOOP_GM_ALLOCATION_BYTES);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<uint8_t> local = allocator.Alloc<uint8_t, kLocalWorkspaceBytes>();
    const AscendC::DataCopyParams copyParams{1, kAccessBytes / 32, 0, 0};

#if VECTOR_LOOP_DIRECTION == 1
    const AscendC::LoopModeParams loopParams{kLoop1Size, kLoop2Size, kGmLoop1StrideBytes,
        kLocalLoop1StrideBytes, kGmLoop2StrideBytes, kLocalLoop2StrideBytes};
    AscendC::SetLoopModePara(loopParams, AscendC::DataCopyMVType::OUT_TO_UB);
    // GM reads are [0, 32), [64, 96), [192, 224), [256, 288), [384, 416), and [448, 480).
    AscendC::DataCopy(local, gmTensor, copyParams);
    AscendC::ResetLoopModePara(AscendC::DataCopyMVType::OUT_TO_UB);
#else
    const AscendC::LoopModeParams loopParams{kLoop1Size, kLoop2Size, kLocalLoop1StrideBytes,
        kGmLoop1StrideBytes, kLocalLoop2StrideBytes, kGmLoop2StrideBytes};
    AscendC::SetLoopModePara(loopParams, AscendC::DataCopyMVType::UB_TO_OUT);
    // GM writes are [0, 32), [64, 96), [192, 224), [256, 288), [384, 416), and [448, 480).
    AscendC::DataCopy(gmTensor, local, copyParams);
    AscendC::ResetLoopModePara(AscendC::DataCopyMVType::UB_TO_OUT);
#endif

    AscendC::PipeBarrier<PIPE_ALL>();
    (void)unused;
    (void)guard;
}

int main()
{
    std::printf(
        "VECTOR_LOOP_DIRECTION=%s VECTOR_LOOP_EXPECTED_GM_FOOTPRINT_BYTES=%u "
        "VECTOR_LOOP_ALLOCATED_GM_BYTES=%zu\n",
        VECTOR_LOOP_DIRECTION == kGmToUb ? "GM_TO_UB" : "UB_TO_GM", kGmAccessEndBytes,
        static_cast<size_t>(VECTOR_LOOP_GM_ALLOCATION_BYTES));

    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(VECTOR_LOOP_GM_ALLOCATION_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(
        aclrtMalloc(reinterpret_cast<void**>(&first), VECTOR_LOOP_GM_ALLOCATION_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        first, VECTOR_LOOP_GM_ALLOCATION_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));

    VectorLoopMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
