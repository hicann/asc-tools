/*!
 * \file fixpipe_memory_case.asc
 * \brief L0C-to-GM Fixpipe memory-access case.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef DEVICE_CASE_OUTPUT_BYTES
#error "DEVICE_CASE_OUTPUT_BYTES is required"
#endif

#ifndef DEVICE_CASE_FIXPIPE_INSTRUCTION_ID
#define DEVICE_CASE_FIXPIPE_INSTRUCTION_ID 91
#endif

#ifndef DEVICE_CASE_FIXPIPE_LAYOUT
#define DEVICE_CASE_FIXPIPE_LAYOUT 0
#endif

static_assert(DEVICE_CASE_OUTPUT_BYTES > 0, "DEVICE_CASE_OUTPUT_BYTES must be nonzero");
static_assert(
    DEVICE_CASE_FIXPIPE_INSTRUCTION_ID == 91 || DEVICE_CASE_FIXPIPE_INSTRUCTION_ID == 92,
    "DEVICE_CASE_FIXPIPE_INSTRUCTION_ID must be 91 or 92");
static_assert(
    DEVICE_CASE_FIXPIPE_LAYOUT >= 0 && DEVICE_CASE_FIXPIPE_LAYOUT <= 2,
    "DEVICE_CASE_FIXPIPE_LAYOUT must be 0 (NZ), 1 (strided NZ2ND), or 2 (strided NZ2DN)");

namespace {

constexpr uint16_t kFixpipeN = 16;
constexpr uint16_t kFixpipeM = 16;
constexpr uint16_t kFixpipeSrcStride = 16;
constexpr uint16_t kFixpipeContiguousDstStride = 16;
constexpr uint16_t kFixpipeStridedDstStride = 32;
constexpr uint16_t kFixpipeLoop3Count = 2;
constexpr uint16_t kFixpipeLoop3SrcStride = 16;
constexpr uint32_t kFixpipeLoop3DstStride = 512;
constexpr uint16_t kFixpipeNz2DnC0Stride = 1;
constexpr uint32_t kFixpipeL0cElements = 512;

template <typename DstT, typename SrcT>
__aicore__ inline void RunFixpipe(
    const AscendC::GlobalTensor<DstT>& dst, const AscendC::LocalTensor<SrcT>& src, QuantMode_t quantMode)
{
#if DEVICE_CASE_FIXPIPE_LAYOUT == 2
    AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::COLUMN_MAJOR> params(
        kFixpipeN, kFixpipeM, kFixpipeSrcStride, kFixpipeStridedDstStride);
    params.quantPre = quantMode;
    params.params = AscendC::Nz2DnParams{
        kFixpipeLoop3Count, kFixpipeLoop3SrcStride, kFixpipeLoop3DstStride, kFixpipeNz2DnC0Stride};
    AscendC::Fixpipe<DstT, SrcT, AscendC::CFG_COLUMN_MAJOR>(dst, src, params);
#elif DEVICE_CASE_FIXPIPE_LAYOUT == 1
    AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> params(
        kFixpipeN, kFixpipeM, kFixpipeSrcStride, kFixpipeStridedDstStride);
    params.quantPre = quantMode;
    params.params =
        AscendC::Nz2NdParams{kFixpipeLoop3Count, kFixpipeLoop3SrcStride, kFixpipeLoop3DstStride};
    AscendC::Fixpipe<DstT, SrcT, AscendC::CFG_ROW_MAJOR>(dst, src, params);
#else
    AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::NZ> params(
        kFixpipeN, kFixpipeM, kFixpipeSrcStride, kFixpipeContiguousDstStride);
    params.quantPre = quantMode;
    AscendC::Fixpipe<DstT, SrcT, AscendC::CFG_NZ>(dst, src, params);
#endif
}

} // namespace

extern "C" __cube__ __global__ void FixpipeMemoryCaseKernel(
    __gm__ uint8_t* first, __gm__ uint8_t* second, __gm__ uint8_t* output)
{
    AscendC::InitSocState();
#if DEVICE_CASE_FIXPIPE_INSTRUCTION_ID == 91
    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> outGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(first), 256);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(second), 256);
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(output), DEVICE_CASE_OUTPUT_BYTES / sizeof(half));

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0a;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0b;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0c;
    AscendC::LocalTensor<half> a1 = l1.Alloc<AscendC::TPosition::A1, half>(256);
    AscendC::LocalTensor<half> b1 = l1.Alloc<AscendC::TPosition::B1, half>(256);
    AscendC::LocalTensor<half> a2 = l0a.Alloc<AscendC::TPosition::A2, half>(256);
    AscendC::LocalTensor<half> b2 = l0b.Alloc<AscendC::TPosition::B2, half>(256);
    AscendC::LocalTensor<float> c = l0c.Alloc<AscendC::TPosition::CO1, float>(kFixpipeL0cElements);

    AscendC::DataCopy(a1, aGm, AscendC::Nd2NzParams{1, 16, 16, 0, 16, 16, 1, 0});
    AscendC::DataCopy(b1, bGm, AscendC::Nd2NzParams{1, 16, 16, 0, 16, 16, 1, 0});
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::LoadData(a2, a1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, false, 0});
    AscendC::LoadData(b2, b1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, true, 0});
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::Mmad(c, a2, b2, AscendC::MmadParams{16, 16, 16, 0, false, true});
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    RunFixpipe(outGm, c, QuantMode_t::F322F16);
#else
    AscendC::GlobalTensor<int32_t> outGm;
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(output), DEVICE_CASE_OUTPUT_BYTES / sizeof(int32_t));

    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0c;
    AscendC::LocalTensor<int32_t> c = l0c.Alloc<AscendC::TPosition::CO1, int32_t>(kFixpipeL0cElements);

    RunFixpipe(outGm, c, QuantMode_t::NoQuant);
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    constexpr size_t kInputBytes = 512;
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(kInputBytes, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), kInputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), kInputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), DEVICE_CASE_OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, kInputBytes, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(second, kInputBytes, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    FixpipeMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    if (!CheckAclResult(syncResult, "aclrtSynchronizeStream(stream)")) {
        status = 1;
    }

cleanup:
    if (first != nullptr && !CheckAclResult(aclrtFree(first), "aclrtFree(first)")) {
        status = 1;
    }
    if (second != nullptr && !CheckAclResult(aclrtFree(second), "aclrtFree(second)")) {
        status = 1;
    }
    if (third != nullptr && !CheckAclResult(aclrtFree(third), "aclrtFree(third)")) {
        status = 1;
    }
    if (stream != nullptr && !CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream(stream)")) {
        status = 1;
    }
    if (deviceSet && !CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice(deviceId)")) {
        status = 1;
    }
    if (aclInitialized && !CheckAclResult(aclFinalize(), "aclFinalize()")) {
        status = 1;
    }
    return status;
}
