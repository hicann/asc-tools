/*!
 * \file cube_dma_memory_case.asc
 * \brief Parameterized dav-3510 GM-to-L1 padding and aligned DMA cases.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef CUBE_DMA_INSTRUCTION_ID
#error "CUBE_DMA_INSTRUCTION_ID is required"
#endif
#ifndef CUBE_DMA_SOURCE_BYTES
#error "CUBE_DMA_SOURCE_BYTES is required"
#endif
#ifndef CUBE_DMA_PADDING_MODE
#define CUBE_DMA_PADDING_MODE 5
#endif

static_assert(
    CUBE_DMA_INSTRUCTION_ID >= 73 && CUBE_DMA_INSTRUCTION_ID <= 76,
    "CUBE_DMA_INSTRUCTION_ID must be 73, 74, 75, or 76");
static_assert(CUBE_DMA_SOURCE_BYTES > 0, "CUBE_DMA_SOURCE_BYTES must be nonzero");
static_assert(CUBE_DMA_PADDING_MODE >= 0 && CUBE_DMA_PADDING_MODE <= 8, "CUBE_DMA_PADDING_MODE must be in [0, 8]");

namespace {

constexpr uint32_t kBurstCount = 3;
constexpr uint32_t kAlignedBurstBytes = 32;
constexpr uint64_t kAlignedBurstSrcStrideBytes = 64;
constexpr uint32_t kAlignedBurstDstStrideBytes = 32;
constexpr uint8_t kPaddingMode = CUBE_DMA_PADDING_MODE;
constexpr uint32_t kPaddingBurstLength = 1;
constexpr bool kInsertsPadding = kPaddingMode >= 1 && kPaddingMode <= 5;
constexpr uint64_t kPaddingSourceStride = kInsertsPadding ? 0 : 1;
constexpr uint32_t kPaddingSourceBytesPerBurst =
    kInsertsPadding ? (UINT32_C(1) << (kPaddingMode - 1)) : 32;
constexpr uint32_t kPaddingSourceFootprintBytes = kInsertsPadding
                                                     ? kBurstCount * kPaddingSourceBytesPerBurst
                                                     : (kBurstCount - 1) * 32 + kPaddingSourceBytesPerBurst;
constexpr uint32_t kAlignedSourceFootprintBytes =
    (kBurstCount - 1) * kAlignedBurstSrcStrideBytes + kAlignedBurstBytes;
constexpr uint32_t kL1WorkspaceBytes = 512;

} // namespace

extern "C" __cube__ __global__ void CubeDmaMemoryCaseKernel(
    __gm__ uint8_t* source, __gm__ uint8_t* output, __gm__ uint8_t* guard)
{
    asc_init();
    __cbuf__ uint8_t local[kL1WorkspaceBytes];

#if CUBE_DMA_INSTRUCTION_ID == 73
    // All padding modes lower to copy_gm_to_cbuf_v2 (ID 73). Modes 1-5
    // consume 1/2/4/8/16 contiguous source bytes per burst.
    asc_copy_gm2l1(
        reinterpret_cast<__cbuf__ void*>(local), reinterpret_cast<__gm__ void*>(source), kBurstCount,
        kPaddingBurstLength, kPaddingMode, kPaddingSourceStride, 0);
#elif CUBE_DMA_INSTRUCTION_ID == 74
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ uint8_t*>(local), reinterpret_cast<__gm__ uint8_t*>(source), kBurstCount,
        kAlignedBurstBytes, 0, 0, false, 0, kAlignedBurstSrcStrideBytes, kAlignedBurstDstStrideBytes);
#elif CUBE_DMA_INSTRUCTION_ID == 75
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ half*>(local), reinterpret_cast<__gm__ half*>(source), kBurstCount,
        kAlignedBurstBytes, 0, 0, false, 0, kAlignedBurstSrcStrideBytes, kAlignedBurstDstStrideBytes);
#else
    asc_copy_gm2l1_align(
        reinterpret_cast<__cbuf__ float*>(local), reinterpret_cast<__gm__ float*>(source), kBurstCount,
        kAlignedBurstBytes, 0, 0, false, 0, kAlignedBurstSrcStrideBytes, kAlignedBurstDstStrideBytes);
#endif

    asc_sync_pipe(PIPE_ALL);
    (void)output;
    (void)guard;
}

int main()
{
#if CUBE_DMA_INSTRUCTION_ID == 73
    constexpr uint32_t expectedFootprintBytes = kPaddingSourceFootprintBytes;
#else
    constexpr uint32_t expectedFootprintBytes = kAlignedSourceFootprintBytes;
#endif
    std::printf(
        "CUBE_DMA_INSTRUCTION_ID=%d CUBE_DMA_EXPECTED_GM_FOOTPRINT_BYTES=%u "
        "CUBE_DMA_ALLOCATED_GM_BYTES=%zu\n",
        CUBE_DMA_INSTRUCTION_ID, expectedFootprintBytes, static_cast<size_t>(CUBE_DMA_SOURCE_BYTES));

    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(CUBE_DMA_SOURCE_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), CUBE_DMA_SOURCE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(first, CUBE_DMA_SOURCE_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));

    CubeDmaMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
