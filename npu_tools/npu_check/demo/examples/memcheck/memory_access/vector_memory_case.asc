/*!
 * \file vector_memory_case.asc
 * \brief Parameterized GM and UB memory-access cases for memcheck.
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <vector>

namespace {
bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation) \
    do { \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1; \
            goto cleanup; \
        } \
    } while (false)

#ifndef DEVICE_CASE_KIND
#error "DEVICE_CASE_KIND is required"
#endif
#ifndef DEVICE_CASE_FIRST_BYTES
#error "DEVICE_CASE_FIRST_BYTES is required"
#endif
#ifndef DEVICE_CASE_SECOND_BYTES
#error "DEVICE_CASE_SECOND_BYTES is required"
#endif
#ifndef DEVICE_CASE_ACCESS_BYTES
#error "DEVICE_CASE_ACCESS_BYTES is required"
#endif
#ifndef DEVICE_CASE_DATA_BITS
#define DEVICE_CASE_DATA_BITS 8
#endif

static_assert(DEVICE_CASE_KIND >= 1 && DEVICE_CASE_KIND <= 3, "DEVICE_CASE_KIND must be 1, 2, or 3");
static_assert(DEVICE_CASE_FIRST_BYTES > 0, "DEVICE_CASE_FIRST_BYTES must be nonzero");
static_assert(DEVICE_CASE_SECOND_BYTES > 0, "DEVICE_CASE_SECOND_BYTES must be nonzero");
static_assert(DEVICE_CASE_ACCESS_BYTES > 0, "DEVICE_CASE_ACCESS_BYTES must be nonzero");
static_assert(
    DEVICE_CASE_DATA_BITS == 8 || DEVICE_CASE_DATA_BITS == 16 || DEVICE_CASE_DATA_BITS == 32,
    "DEVICE_CASE_DATA_BITS must be 8, 16, or 32");
static_assert(DEVICE_CASE_FIRST_BYTES % (DEVICE_CASE_DATA_BITS / 8) == 0, "first allocation must contain full elements");
static_assert(
    DEVICE_CASE_SECOND_BYTES % (DEVICE_CASE_DATA_BITS / 8) == 0, "second allocation must contain full elements");
static_assert(DEVICE_CASE_ACCESS_BYTES % (DEVICE_CASE_DATA_BITS / 8) == 0, "access must contain full elements");

#if DEVICE_CASE_DATA_BITS == 8
using Element = uint8_t;
#elif DEVICE_CASE_DATA_BITS == 16
using Element = uint16_t;
#else
using Element = uint32_t;
#endif

extern "C" __vector__ __global__ void VectorMemoryCaseKernel(
    __gm__ uint8_t* first, __gm__ uint8_t* second, __gm__ uint8_t* third)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<Element> firstGm;
    AscendC::GlobalTensor<Element> secondGm;
    firstGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ Element*>(first), DEVICE_CASE_FIRST_BYTES / sizeof(Element));
    secondGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ Element*>(second), DEVICE_CASE_SECOND_BYTES / sizeof(Element));

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<Element> local = allocator.Alloc<Element, 8192 / sizeof(Element)>();

#if DEVICE_CASE_KIND == 1
    AscendC::DataCopy(local, firstGm, DEVICE_CASE_ACCESS_BYTES / sizeof(Element));
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(secondGm, local, 32 / sizeof(Element));
#elif DEVICE_CASE_KIND == 2
    AscendC::DataCopy(local, firstGm, 4096 / sizeof(Element));
    AscendC::PipeBarrier<PIPE_ALL>();
    const AscendC::DataCopyParams params{1, DEVICE_CASE_ACCESS_BYTES / 32, 0, 0};
    AscendC::DataCopy(secondGm, local, params);
#else
    const AscendC::DataCopyParams params{3, 1, 1, 0};
    AscendC::DataCopy(local, firstGm, params);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(secondGm, local, 32 / sizeof(Element));
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
    (void)third;
}

int main()
{
    constexpr int32_t deviceId = 0;
    int status = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t* first = nullptr;
    uint8_t* second = nullptr;
    uint8_t* third = nullptr;
    aclError syncResult = ACL_SUCCESS;
    std::vector<uint8_t> input(DEVICE_CASE_FIRST_BYTES, 1);

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(deviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&first), DEVICE_CASE_FIRST_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&second), DEVICE_CASE_SECOND_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&third), 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        first, DEVICE_CASE_FIRST_BYTES, input.data(), input.size(), ACL_MEMCPY_HOST_TO_DEVICE));

    VectorMemoryCaseKernel<<<1, 0, stream>>>(first, second, third);
    syncResult = aclrtSynchronizeStream(stream);
    std::printf("DEVICE_SYNC_RESULT=%d\n", static_cast<int>(syncResult));
    status |= CheckAclResult(syncResult, "aclrtSynchronizeStream") ? 0 : 1;

cleanup:
    if (first != nullptr) status |= CheckAclResult(aclrtFree(first), "aclrtFree(first)") ? 0 : 1;
    if (second != nullptr) status |= CheckAclResult(aclrtFree(second), "aclrtFree(second)") ? 0 : 1;
    if (third != nullptr) status |= CheckAclResult(aclrtFree(third), "aclrtFree(third)") ? 0 : 1;
    if (stream != nullptr) status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    if (deviceSet) status |= CheckAclResult(aclrtResetDevice(deviceId), "aclrtResetDevice") ? 0 : 1;
    if (aclInitialized) status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    return status;
}
