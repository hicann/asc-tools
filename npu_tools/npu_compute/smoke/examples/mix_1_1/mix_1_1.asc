#include "acl/acl.h"
#include "kernel_operator.h"

#include <array>
#include <cmath>
#include <cstdint>
#include <cstdio>

namespace {
constexpr uint32_t kM = 16;
constexpr uint32_t kK = 16;
constexpr uint32_t kN = 16;
constexpr uint32_t kTilesPerBlock = 32;
constexpr uint32_t kElementCountPerTile = kM * kN;
constexpr uint32_t kAElementsPerTile = kM * kK;
constexpr uint32_t kBElementsPerTile = kK * kN;
constexpr uint32_t kElementCount = kTilesPerBlock * kElementCountPerTile;
constexpr uint32_t kAElementsPerBlock = kTilesPerBlock * kAElementsPerTile;
constexpr uint32_t kBElementsPerBlock = kTilesPerBlock * kBElementsPerTile;
constexpr uint32_t kBlockCount = 8;
constexpr int32_t kDeviceId = 0;

bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation)                            \
    do {                                                \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1;                                 \
            goto cleanup;                               \
        }                                               \
    } while (false)

__global__ __mix__(1, 1) void mix_1_1_kernel(__gm__ half* a, __gm__ half* b, __gm__ half* c)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> cGm;
    const uint32_t blockIndex = AscendC::GetBlockIdx();
    aGm.SetGlobalBuffer(a + blockIndex * kAElementsPerBlock, kAElementsPerBlock);
    bGm.SetGlobalBuffer(b + blockIndex * kBElementsPerBlock, kBElementsPerBlock);
    cGm.SetGlobalBuffer(c + blockIndex * kElementCount, kElementCount);
    if ASCEND_IS_AIC {
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Allocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAllocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAllocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAllocator;
        AscendC::LocalTensor<half> aL1 = l1Allocator.Alloc<AscendC::TPosition::A1, half>(kAElementsPerTile);
        AscendC::LocalTensor<half> bL1 = l1Allocator.Alloc<AscendC::TPosition::B1, half>(kBElementsPerTile);
        AscendC::LocalTensor<half> aL0 = l0aAllocator.Alloc<AscendC::TPosition::A2, half>(kAElementsPerTile);
        AscendC::LocalTensor<half> bL0 = l0bAllocator.Alloc<AscendC::TPosition::B2, half>(kBElementsPerTile);
        AscendC::LocalTensor<float> cL0 = l0cAllocator.Alloc<AscendC::TPosition::CO1, float>(kElementCountPerTile);
        for (uint32_t tile = 0; tile < kTilesPerBlock; ++tile) {
            AscendC::DataCopy(
                aL1, aGm[tile * kAElementsPerTile], AscendC::Nd2NzParams{1, kM, kK, 0, kK, kM, 1, 0});
            AscendC::DataCopy(
                bL1, bGm[tile * kBElementsPerTile], AscendC::Nd2NzParams{1, kK, kN, 0, kN, kK, 1, 0});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
            AscendC::LoadData(aL0, aL1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, false, 0});
            AscendC::LoadData(bL0, bL1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, true, 0});
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::Mmad(cL0, aL0, bL0, AscendC::MmadParams{kM, kN, kK, 0, false, true});
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::Fixpipe(cGm[tile * kElementCountPerTile], cL0,
                AscendC::FixpipeParamsV220{kN, kM, kM, kN, false, QuantMode_t::F322F16, 0, 1, 0, 0, 0});
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        AscendC::CrossCoreSetFlag<3, PIPE_FIX>(0);
    }
    if ASCEND_IS_AIV {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<half> resultLocal = ubAllocator.Alloc<half, kElementCountPerTile>();
        AscendC::CrossCoreWaitFlag<3, PIPE_S>(0);
        for (uint32_t tile = 0; tile < kTilesPerBlock; ++tile) {
            AscendC::DataCopy(resultLocal, cGm[tile * kElementCountPerTile], kElementCountPerTile);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::LeakyRelu(resultLocal, resultLocal, static_cast<half>(0.001f), kElementCountPerTile);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopy(cGm[tile * kElementCountPerTile], resultLocal, kElementCountPerTile);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    constexpr size_t kABytes = kBlockCount * kAElementsPerBlock * sizeof(half);
    constexpr size_t kBBytes = kBlockCount * kBElementsPerBlock * sizeof(half);
    constexpr size_t kCBytes = kBlockCount * kElementCount * sizeof(half);
    std::array<half, kBlockCount * kAElementsPerBlock> aHost{};
    std::array<half, kBlockCount * kBElementsPerBlock> bHost{};
    std::array<half, kBlockCount * kElementCount> cHost{};
    half* aDevice = nullptr;
    half* bDevice = nullptr;
    half* cDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int status = 0;
    const half negativeSlope = static_cast<half>(0.001f);

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t tile = 0; tile < kTilesPerBlock; ++tile) {
            const half value = static_cast<half>(-static_cast<float>((block + 1) * (tile + 1)));
            for (uint32_t element = 0; element < kAElementsPerTile; ++element) {
                aHost[block * kAElementsPerBlock + tile * kAElementsPerTile + element] = value;
            }
        }
    }
    bHost.fill(static_cast<half>(1.0f));

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&aDevice), kABytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&bDevice), kBBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&cDevice), kCBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(aDevice, kABytes, aHost.data(), kABytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(bDevice, kBBytes, bHost.data(), kBBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    mix_1_1_kernel<<<kBlockCount, nullptr, stream>>>(aDevice, bDevice, cDevice);
    ACL_CHECK(aclrtGetLastError(ACL_RT_THREAD_LEVEL));
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(cHost.data(), kCBytes, cDevice, kCBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t tile = 0; tile < kTilesPerBlock; ++tile) {
            const float mmadResult = -static_cast<float>((block + 1) * (tile + 1) * kK);
            const float expected = static_cast<float>(
                static_cast<half>(mmadResult * static_cast<float>(negativeSlope)));
            for (uint32_t element = 0; element < kElementCountPerTile; ++element) {
                const uint32_t index = block * kElementCount + tile * kElementCountPerTile + element;
                const float actual = static_cast<float>(cHost[index]);
                if (std::fabs(actual - expected) > 0.001f) {
                    std::fprintf(stderr, "mix_1_1 mismatch at block %u, tile %u, element %u: got %f, expected %f\n",
                        block, tile, element, actual, expected);
                    status = 1;
                    break;
                }
            }
            if (status != 0) {
                break;
            }
        }
        if (status != 0) {
            break;
        }
    }

cleanup:
    if (cDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(cDevice), "aclrtFree(cDevice)") ? 0 : 1;
    }
    if (bDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(bDevice), "aclrtFree(bDevice)") ? 0 : 1;
    }
    if (aDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(aDevice), "aclrtFree(aDevice)") ? 0 : 1;
    }
    if (stream != nullptr) {
        status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    }
    if (deviceSet) {
        status |= CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") ? 0 : 1;
    }
    if (aclInitialized) {
        status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    }
    if (status == 0) {
        for (uint32_t block = 0; block < kBlockCount; ++block) {
            std::printf("result verification passed: mix_1_1 block=%u\n", block);
        }
        std::printf("result verification passed: mix_1_1\n");
    }
    return status;
}
