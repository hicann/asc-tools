#include "acl/acl.h"
#include "kernel_operator.h"

#include <array>
#include <cstdint>
#include <cstdio>

namespace {
constexpr uint32_t kElementsPerBlock = 4096;
constexpr uint32_t kBlockCount = 8;
constexpr uint32_t kElementCount = kBlockCount * kElementsPerBlock;
constexpr int32_t kDeviceId = 0;

bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation)                         \
    do {                                             \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1;                              \
            goto cleanup;                            \
        }                                            \
    } while (false)

__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t value, uint32_t divisor)
{
    return (value + divisor - 1) / divisor;
}

template <typename T, uint32_t singleCoreLength>
__simd_vf__ inline void AddVF(__ubuf__ T* destination, uint32_t count)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
    const uint32_t repeatTimes = DivCeil(singleCoreLength, oneRepeatSize);
    uint32_t remaining = count;
    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<T> sourceReg;
    AscendC::Reg::RegTensor<T> destinationReg;

    for (uint32_t i = 0; i < repeatTimes; ++i) {
        mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign(sourceReg, destination + i * oneRepeatSize);
        AscendC::Reg::LoadAlign(destinationReg, destination + i * oneRepeatSize);
        AscendC::Reg::Add(destinationReg, destinationReg, sourceReg, mask);
        AscendC::Reg::StoreAlign(destination + i * oneRepeatSize, destinationReg, mask);
    }
}

template <uint32_t singleCoreLength>
__global__ __vector__ void reg_add_kernel(__gm__ float* input, __gm__ float* output)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> inputGm;
    AscendC::GlobalTensor<float> outputGm;
    const uint32_t blockOffset = AscendC::GetBlockIdx() * singleCoreLength;
    inputGm.SetGlobalBuffer(input + blockOffset, singleCoreLength);
    outputGm.SetGlobalBuffer(output + blockOffset, singleCoreLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> outputLocal = ubAllocator.Alloc<float, singleCoreLength>();

    AscendC::DataCopy(outputLocal, inputGm, singleCoreLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    __ubuf__ float* destination = reinterpret_cast<__ubuf__ float*>(outputLocal.GetPhyAddr());
    asc_vf_call<AddVF<float, singleCoreLength>>(destination, singleCoreLength);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outputGm, outputLocal, singleCoreLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    constexpr size_t kBufferBytes = kElementCount * sizeof(float);
    std::array<float, kElementCount> inputHost{};
    std::array<float, kElementCount> outputHost{};
    float* inputDevice = nullptr;
    float* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int status = 0;

    for (uint32_t i = 0; i < kElementCount; ++i) {
        inputHost[i] = static_cast<float>(i);
    }

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&inputDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(
        inputDevice, kBufferBytes, inputHost.data(), kBufferBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    reg_add_kernel<kElementsPerBlock><<<kBlockCount, nullptr, stream>>>(inputDevice, outputDevice);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(
        outputHost.data(), kBufferBytes, outputDevice, kBufferBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t element = 0; element < kElementsPerBlock; ++element) {
            const uint32_t index = block * kElementsPerBlock + element;
            const float expected = static_cast<float>(2 * index);
            if (outputHost[index] != expected) {
                std::fprintf(
                    stderr, "reg_add mismatch at block %u, element %u: got %f, expected %f\n", block, element,
                    outputHost[index], expected);
                status = 1;
                break;
            }
        }
        if (status != 0) {
            break;
        }
    }

cleanup:
    if (outputDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(outputDevice), "aclrtFree(outputDevice)") ? 0 : 1;
    }
    if (inputDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(inputDevice), "aclrtFree(inputDevice)") ? 0 : 1;
    }
    if (stream != nullptr) {
        status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    }
    if (deviceSet) {
        status |= CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") ? 0 : 1;
    }
    if (aclInitialized) {
        status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    }
    if (status == 0) {
        for (uint32_t block = 0; block < kBlockCount; ++block) {
            std::printf("result verification passed: reg_add block=%u\n", block);
        }
        std::printf("result verification passed: reg_add\n");
    }
    return status;
}
