#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#include <array>
#include <cstdint>
#include <cstdio>

namespace {
constexpr uint32_t kBlocksPerGrid = 8;
constexpr uint32_t kThreadsPerBlock = 256;
constexpr uint32_t kValuesPerThread = 64;
constexpr uint32_t kElementCount = kBlocksPerGrid * kThreadsPerBlock * kValuesPerThread;
constexpr uint32_t kDynamicUbSize = 0;
constexpr int32_t kDeviceId = 0;

bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation)                         \
    do {                                             \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1;                              \
            goto cleanup;                            \
        }                                            \
    } while (false)

__global__ void simt_hello_kernel(uint32_t* output)
{
    const uint32_t threadIndex = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t firstElement = threadIndex * kValuesPerThread;
    for (uint32_t valueIndex = 0; valueIndex < kValuesPerThread; ++valueIndex) {
        output[firstElement + valueIndex] = firstElement + valueIndex;
    }
}

int main()
{
    constexpr size_t kBufferBytes = kElementCount * sizeof(uint32_t);
    std::array<uint32_t, kElementCount> outputHost{};
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int status = 0;

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    simt_hello_kernel<<<kBlocksPerGrid, kThreadsPerBlock, kDynamicUbSize, stream>>>(outputDevice);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(
        outputHost.data(), kBufferBytes, outputDevice, kBufferBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t block = 0; block < kBlocksPerGrid; ++block) {
        for (uint32_t thread = 0; thread < kThreadsPerBlock; ++thread) {
            const uint32_t firstElement = (block * kThreadsPerBlock + thread) * kValuesPerThread;
            for (uint32_t valueIndex = 0; valueIndex < kValuesPerThread; ++valueIndex) {
                const uint32_t index = firstElement + valueIndex;
                if (outputHost[index] != index) {
                    std::fprintf(
                        stderr, "simt_hello mismatch at block %u, thread %u, value %u: got %u, expected %u\n", block,
                        thread, valueIndex, outputHost[index], index);
                    status = 1;
                    break;
                }
            }
            if (status != 0) {
                break;
            }
        }
        if (status != 0) {
            break;
        }
    }

cleanup:
    if (outputDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(outputDevice), "aclrtFree(outputDevice)") ? 0 : 1;
    }
    if (stream != nullptr) {
        status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    }
    if (deviceSet) {
        status |= CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") ? 0 : 1;
    }
    if (aclInitialized) {
        status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    }
    if (status == 0) {
        for (uint32_t block = 0; block < kBlocksPerGrid; ++block) {
            std::printf("result verification passed: simt_hello block=%u\n", block);
        }
        std::printf("result verification passed: simt_hello\n");
    }
    return status;
}
