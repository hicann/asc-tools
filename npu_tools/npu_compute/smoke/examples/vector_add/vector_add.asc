#include "acl/acl.h"
#include "kernel_operator.h"

#include <array>
#include <cstdint>
#include <cstdio>

namespace {
constexpr uint32_t kElementsPerBlock = 4096;
constexpr uint32_t kBlockCount = 8;
constexpr uint32_t kElementCount = kBlockCount * kElementsPerBlock;
constexpr int32_t kDeviceId = 0;

bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}
} // namespace

#define ACL_CHECK(operation)                         \
    do {                                             \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1;                              \
            goto cleanup;                            \
        }                                            \
    } while (false)

template <uint32_t blockLength>
__vector__ __global__ void vector_add_kernel(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    const uint32_t blockOffset = AscendC::GetBlockIdx() * blockLength;
    xGm.SetGlobalBuffer(x + blockOffset, blockLength);
    yGm.SetGlobalBuffer(y + blockOffset, blockLength);
    zGm.SetGlobalBuffer(z + blockOffset, blockLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, blockLength>();

    AscendC::DataCopy(xLocal, xGm, blockLength);
    AscendC::DataCopy(yLocal, yGm, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    constexpr size_t kBufferBytes = kElementCount * sizeof(float);
    std::array<float, kElementCount> xHost{};
    std::array<float, kElementCount> yHost{};
    std::array<float, kElementCount> zHost{};
    float* xDevice = nullptr;
    float* yDevice = nullptr;
    float* zDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int status = 0;

    for (uint32_t i = 0; i < kElementCount; ++i) {
        xHost[i] = static_cast<float>(i);
        yHost[i] = static_cast<float>(2 * i);
    }

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&xDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&yDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&zDevice), kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(xDevice, kBufferBytes, xHost.data(), kBufferBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(yDevice, kBufferBytes, yHost.data(), kBufferBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    vector_add_kernel<kElementsPerBlock><<<kBlockCount, nullptr, stream>>>(xDevice, yDevice, zDevice);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(zHost.data(), kBufferBytes, zDevice, kBufferBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t element = 0; element < kElementsPerBlock; ++element) {
            const uint32_t index = block * kElementsPerBlock + element;
            const float expected = static_cast<float>(3 * index);
            if (zHost[index] != expected) {
                std::fprintf(
                    stderr, "vector_add mismatch at block %u, element %u: got %f, expected %f\n", block, element,
                    zHost[index], expected);
                status = 1;
                break;
            }
        }
        if (status != 0) {
            break;
        }
    }

cleanup:
    if (zDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(zDevice), "aclrtFree(zDevice)") ? 0 : 1;
    }
    if (yDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(yDevice), "aclrtFree(yDevice)") ? 0 : 1;
    }
    if (xDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(xDevice), "aclrtFree(xDevice)") ? 0 : 1;
    }
    if (stream != nullptr) {
        status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    }
    if (deviceSet) {
        status |= CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") ? 0 : 1;
    }
    if (aclInitialized) {
        status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    }
    if (status == 0) {
        for (uint32_t block = 0; block < kBlockCount; ++block) {
            std::printf("result verification passed: vector_add block=%u\n", block);
        }
        std::printf("result verification passed: vector_add\n");
    }
    return status;
}
