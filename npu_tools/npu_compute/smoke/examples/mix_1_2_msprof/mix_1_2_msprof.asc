#include "acl/acl.h"
#include "kernel_operator.h"
#include "profiling/prof_api.h"

#include <algorithm>
#include <array>
#include <atomic>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstdio>

namespace {
constexpr uint32_t kM = 16;
constexpr uint32_t kK = 16;
constexpr uint32_t kN = 16;
constexpr uint32_t kHalfRows = kM / 2;
constexpr uint32_t kHalfElementCount = kHalfRows * kN;
constexpr uint32_t kElementCount = kM * kN;
constexpr uint32_t kAElementsPerBlock = kM * kK;
constexpr uint32_t kBElementsPerBlock = kK * kN;
constexpr uint32_t kBlockCount = 8;
constexpr int32_t kDeviceId = 0;
constexpr uint32_t kMsprofCollectionType = 8;
constexpr size_t kPmuRecordSize = 128;
constexpr uint32_t kPmuMagic = 0x6bd3U;
// PMU function values distinguish task-wide and per-block records in the raw callback payload.
constexpr uint32_t kBlockPmuFunction = 0x29U;
constexpr uint32_t kTaskPmuFunction = 0x2aU;

constexpr std::array<uint32_t, COMPUTE_AICORE_METRICS_NUM> kPmuEvents = {
    1060, 1061, 1062, 1063, 1064, 1065, 1066, 1067, 1068,
};
static_assert(kPmuEvents.size() == COMPUTE_AICORE_METRICS_NUM);

std::atomic<uint32_t> gTaskPmuRecords{0};
std::atomic<uint32_t> gBlockPmuRecords{0};

bool CheckAclResult(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}

bool CheckMsprofResult(int32_t result, const char* operation)
{
    if (result == 0) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, result);
    return false;
}

uint32_t ReadWord(const char* data, size_t wordIndex)
{
    const auto* bytes = reinterpret_cast<const unsigned char*>(data + wordIndex * sizeof(uint32_t));
    uint32_t value = 0;
    for (size_t byteIndex = 0; byteIndex < sizeof(value); ++byteIndex) {
        value |= static_cast<uint32_t>(bytes[byteIndex]) << (byteIndex * 8U);
    }
    return value;
}

uint64_t ReadCounter(const char* data, size_t lowWordIndex)
{
    return static_cast<uint64_t>(ReadWord(data, lowWordIndex)) |
           (static_cast<uint64_t>(ReadWord(data, lowWordIndex + 1)) << 32U);
}

void PrintPmuValues(const char* record)
{
    for (size_t index = 0; index < kPmuEvents.size(); ++index) {
        std::printf(" event_%u=%llu", kPmuEvents[index],
            static_cast<unsigned long long>(ReadCounter(record, 8 + index * 2)));
    }
    std::printf("\n");
}

int32_t OnMsprofRawData(MsprofRawData* rawData)
{
    if (rawData == nullptr) {
        std::fprintf(stderr, "msprof callback received null data\n");
        return -1;
    }
    if (rawData->type != PMU_DATA_TYPE) {
        std::printf("msprof callback ignored raw type=%d size=%zu\n", static_cast<int>(rawData->type),
            rawData->chunkSize);
        return 0;
    }
    if (rawData->chunkSize == 0 || rawData->chunkSize > sizeof(rawData->chunk) ||
        rawData->chunkSize % kPmuRecordSize != 0) {
        std::fprintf(stderr, "msprof callback received invalid PMU chunk size=%zu\n", rawData->chunkSize);
        return -1;
    }

    for (size_t offset = 0; offset < rawData->chunkSize; offset += kPmuRecordSize) {
        const char* record = rawData->chunk + offset;
        const uint32_t header = ReadWord(record, 0);
        const uint32_t function = header & 0x3fU;
        if ((header >> 16U) != kPmuMagic) {
            std::printf("msprof PMU record: invalid magic=0x%04x\n", header >> 16U);
            continue;
        }

        const uint32_t taskAndStream = ReadWord(record, 1);
        const uint16_t taskId = static_cast<uint16_t>(taskAndStream >> 16U);
        const uint16_t streamId = static_cast<uint16_t>(taskAndStream);
        const uint32_t coreInfo = ReadWord(record, 5);
        const uint16_t blockId = static_cast<uint16_t>(ReadWord(record, 6) >> 16U);
        const uint16_t subBlockId = static_cast<uint16_t>(ReadWord(record, 6));
        const unsigned long long cycles = static_cast<unsigned long long>(ReadCounter(record, 2));
        const unsigned int coreType = (coreInfo & 1U) == 0 ? 0U : 1U;
        const unsigned int coreId = coreInfo >> 8U;

        if (function == kTaskPmuFunction) {
            gTaskPmuRecords.fetch_add(1, std::memory_order_relaxed);
            std::printf(
                "msprof PMU task: task_id=%u stream_id=%u core_type=%u core_id=%u cycles=%llu",
                taskId, streamId, coreType, coreId, cycles);
            PrintPmuValues(record);
        } else if (function == kBlockPmuFunction) {
            gBlockPmuRecords.fetch_add(1, std::memory_order_relaxed);
            std::printf(
                "msprof PMU block: task_id=%u stream_id=%u block_id=%u sub_block_id=%u core_type=%u core_id=%u "
                "cycles=%llu",
                taskId, streamId, blockId, subBlockId, coreType, coreId, cycles);
            PrintPmuValues(record);
        } else {
            std::printf("msprof PMU record: unsupported function=0x%02x\n", function);
        }
    }
    return 0;
}

MsprofConfig MakeMsprofConfig(std::array<MsprofConfigAttr, 2>* attrs)
{
    *attrs = {};
    MsprofConfigAttr& metricsAttr = (*attrs)[0];
    metricsAttr.id = PROF_CONFIG_ATTR_AICORE_METRICS;
    std::copy(kPmuEvents.begin(), kPmuEvents.end(), metricsAttr.value.aicoreMetrics);

    MsprofConfigAttr& blockAttr = (*attrs)[1];
    blockAttr.id = PROF_CONFIG_ATTR_TASK_BLOCK;
    blockAttr.value.taskBlockMode = PROF_COMPUTE_ALL_BLOCK;

    MsprofConfig config{};
    config.profSwitch = PROF_AICORE_METRICS_MASK;
    config.devNums = 1;
    config.devIdList[0] = static_cast<uint32_t>(kDeviceId);
    config.configInfo.numAttrs = attrs->size();
    config.configInfo.attrs = attrs->data();
    return config;
}
} // namespace

#define ACL_CHECK(operation)                            \
    do {                                                \
        if (!CheckAclResult((operation), #operation)) { \
            status = 1;                                 \
            goto cleanup;                               \
        }                                               \
    } while (false)

#define MSPROF_CHECK(operation)                            \
    do {                                                   \
        if (!CheckMsprofResult((operation), #operation)) { \
            status = 1;                                    \
            goto cleanup;                                  \
        }                                                  \
    } while (false)

__global__ __mix__(1, 2) void mix_1_2_msprof_kernel(__gm__ half* a, __gm__ half* b, __gm__ half* c)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> cGm;
    if ASCEND_IS_AIC {
        const uint32_t blockIndex = AscendC::GetBlockIdx();
        aGm.SetGlobalBuffer(a + blockIndex * kAElementsPerBlock, kAElementsPerBlock);
        bGm.SetGlobalBuffer(b + blockIndex * kBElementsPerBlock, kBElementsPerBlock);
        cGm.SetGlobalBuffer(c + blockIndex * kElementCount, kElementCount);
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Allocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAllocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAllocator;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAllocator;
        AscendC::LocalTensor<half> aL1 = l1Allocator.Alloc<AscendC::TPosition::A1, half>(kM * kK);
        AscendC::LocalTensor<half> bL1 = l1Allocator.Alloc<AscendC::TPosition::B1, half>(kK * kN);
        AscendC::LocalTensor<half> aL0 = l0aAllocator.Alloc<AscendC::TPosition::A2, half>(kM * kK);
        AscendC::LocalTensor<half> bL0 = l0bAllocator.Alloc<AscendC::TPosition::B2, half>(kK * kN);
        AscendC::LocalTensor<float> cL0 = l0cAllocator.Alloc<AscendC::TPosition::CO1, float>(kElementCount);

        AscendC::DataCopy(aL1, aGm, AscendC::Nd2NzParams{1, kM, kK, 0, kK, kM, 1, 0});
        AscendC::DataCopy(bL1, bGm, AscendC::Nd2NzParams{1, kK, kN, 0, kN, kK, 1, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::LoadData(aL0, aL1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, false, 0});
        AscendC::LoadData(bL0, bL1, AscendC::LoadData2DParamsV2{0, 0, 1, 1, 1, 1, true, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::Mmad(cL0, aL0, bL0, AscendC::MmadParams{kM, kN, kK, 0, false, true});
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::Fixpipe(
            cGm, cL0,
            AscendC::FixpipeParamsV220{kN, kM, kM, kN, false, QuantMode_t::F322F16, 0, 1, 0, 0, 0});
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(0);
    }
    if ASCEND_IS_AIV {
        const uint32_t aivBlockIndex = AscendC::GetBlockIdx();
        const uint32_t batchIndex = aivBlockIndex / 2;
        const uint32_t halfOffset = aivBlockIndex % 2 * kHalfElementCount;
        cGm.SetGlobalBuffer(c + batchIndex * kElementCount, kElementCount);
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<half> resultLocal = ubAllocator.Alloc<half, kHalfElementCount>();
        AscendC::CrossCoreWaitFlag(0);
        AscendC::DataCopy(resultLocal, cGm[halfOffset], kHalfElementCount);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::LeakyRelu(resultLocal, resultLocal, static_cast<half>(0.001f), kHalfElementCount);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(cGm[halfOffset], resultLocal, kHalfElementCount);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    constexpr size_t kABytes = kBlockCount * kAElementsPerBlock * sizeof(half);
    constexpr size_t kBBytes = kBlockCount * kBElementsPerBlock * sizeof(half);
    constexpr size_t kCBytes = kBlockCount * kElementCount * sizeof(half);
    std::array<half, kBlockCount * kAElementsPerBlock> aHost{};
    std::array<half, kBlockCount * kBElementsPerBlock> bHost{};
    std::array<half, kBlockCount * kElementCount> cHost{};
    std::array<MsprofConfigAttr, 2> msprofAttrs{};
    MsprofConfig msprofConfig{};
    half* aDevice = nullptr;
    half* bDevice = nullptr;
    half* cDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    bool profilingStarted = false;
    int status = 0;

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t row = 0; row < kM; ++row) {
            const bool isNegativeRow = row % kHalfRows < kHalfRows / 2;
            const half value = isNegativeRow ? static_cast<half>(-static_cast<float>(block + 1))
                                             : static_cast<half>(block + 1);
            for (uint32_t column = 0; column < kK; ++column) {
                aHost[block * kAElementsPerBlock + row * kK + column] = value;
            }
        }
    }
    bHost.fill(static_cast<half>(1.0f));

    ACL_CHECK(aclInit(nullptr));
    aclInitialized = true;
    ACL_CHECK(aclrtSetDevice(kDeviceId));
    deviceSet = true;
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&aDevice), kABytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&bDevice), kBBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&cDevice), kCBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(aDevice, kABytes, aHost.data(), kABytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(bDevice, kBBytes, bHost.data(), kBBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    if (!CheckMsprofResult(MsprofRegisterDataCallback(0U, reinterpret_cast<void*>(OnMsprofRawData)), "MsprofRegisterDataCallback")) {
        status = 1;
        goto cleanup;
    }
    msprofConfig = MakeMsprofConfig(&msprofAttrs);
    MSPROF_CHECK(MsprofStart(kMsprofCollectionType, &msprofConfig, sizeof(msprofConfig)));
    profilingStarted = true;
    mix_1_2_msprof_kernel<<<kBlockCount, nullptr, stream>>>(aDevice, bDevice, cDevice);
    ACL_CHECK(aclrtGetLastError(ACL_RT_THREAD_LEVEL));
    ACL_CHECK(aclrtSynchronizeStream(stream));
    MSPROF_CHECK(MsprofStop(kMsprofCollectionType, &msprofConfig, sizeof(msprofConfig)));
    profilingStarted = false;
    ACL_CHECK(aclrtMemcpy(cHost.data(), kCBytes, cDevice, kCBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t block = 0; block < kBlockCount; ++block) {
        for (uint32_t element = 0; element < kElementCount; ++element) {
            const uint32_t row = element / kN;
            const uint32_t column = element % kN;
            const bool isNegativeRow = row % kHalfRows < kHalfRows / 2;
            const float magnitude = static_cast<float>((block + 1) * kK);
            const float expected = isNegativeRow ? -magnitude * 0.001f : magnitude;
            const float actual = static_cast<float>(cHost[block * kElementCount + element]);
            if (std::fabs(actual - expected) > 0.001f) {
                std::fprintf(
                    stderr,
                    "mix_1_2_msprof mismatch at block %u, row %u, column %u: got %f, expected %f\n",
                    block, row, column, actual, expected);
                status = 1;
                break;
            }
        }
        if (status != 0) {
            break;
        }
    }

    if (gTaskPmuRecords.load(std::memory_order_relaxed) == 0 ||
        gBlockPmuRecords.load(std::memory_order_relaxed) == 0) {
        std::fprintf(stderr, "msprof callback missing records: task=%u block=%u\n",
            gTaskPmuRecords.load(std::memory_order_relaxed), gBlockPmuRecords.load(std::memory_order_relaxed));
        status = 1;
    }

cleanup:
    if (profilingStarted) {
        status |= CheckMsprofResult(MsprofStop(kMsprofCollectionType, &msprofConfig, sizeof(msprofConfig)),
                      "MsprofStop(cleanup)")
                      ? 0
                      : 1;
    }
    if (cDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(cDevice), "aclrtFree(cDevice)") ? 0 : 1;
    }
    if (bDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(bDevice), "aclrtFree(bDevice)") ? 0 : 1;
    }
    if (aDevice != nullptr) {
        status |= CheckAclResult(aclrtFree(aDevice), "aclrtFree(aDevice)") ? 0 : 1;
    }
    if (stream != nullptr) {
        status |= CheckAclResult(aclrtDestroyStream(stream), "aclrtDestroyStream") ? 0 : 1;
    }
    if (deviceSet) {
        status |= CheckAclResult(aclrtResetDevice(kDeviceId), "aclrtResetDevice") ? 0 : 1;
    }
    if (aclInitialized) {
        status |= CheckAclResult(aclFinalize(), "aclFinalize") ? 0 : 1;
    }
    if (status == 0) {
        for (uint32_t block = 0; block < kBlockCount; ++block) {
            std::printf("result verification passed: mix_1_2_msprof block=%u\n", block);
        }
        std::printf("result verification passed: mix_1_2_msprof\n");
    }
    return status;
}
